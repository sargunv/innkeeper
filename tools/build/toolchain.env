# The Android toolchain pin, shared by every build: mise loads it ([env], which
# also derives ANDROID_HOME and ANDROID_NDK_HOME), container builds get it with
# --env-file, and Gradle reads it from the environment. Plain KEY=VALUE lines.
ANDROID_NDK_VERSION=30.0.16248370
ANDROID_API=37
ANDROID_BUILD_TOOLS=37.0.0
ANDROID_COMPILE_SDK=37
