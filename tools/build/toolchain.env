# The Android toolchain pin that every build shares. mise loads it in [env],
# which also derives ANDROID_HOME and ANDROID_NDK_HOME. Container builds get it
# with --env-file, and Gradle reads it from the environment. The file must hold
# plain KEY=VALUE lines.
ANDROID_NDK_VERSION=30.0.16248370
ANDROID_API=37
ANDROID_BUILD_TOOLS=37.0.0
ANDROID_COMPILE_SDK=37
