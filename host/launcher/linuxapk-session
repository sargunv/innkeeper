#!/usr/bin/env bash
# Linux.apk session launcher: boots the pinned Android image (image/pin.toml)
# in a rootless user + mount + pid + cgroup namespace.
#
#   linuxapk-session start [-f] [--headless] [--single-uid]
#                                  boot (in the background unless -f). Each
#                                  app gets its own host Wayland window
#                                  (docs/windowing.md); --headless opens no
#                                  windows. Binder is served in userspace
#                                  (docs/ubinder.md). --single-uid maps only
#                                  the host user (no /etc/subuid range) and
#                                  virtualizes Android's uids (docs/sandbox.md)
#   linuxapk-session prepare       fetch/extract/flatten/derive the image only
#   linuxapk-session image         print the selected image and its paths
#   linuxapk-session stop          kill the session (its pid 1) and clean up
#   linuxapk-session status
#   linuxapk-session log [-f]      Android init's kernel log (/dev/kmsg)
#   linuxapk-session exec CMD...   run CMD inside the live session as root
#   linuxapk-session shell         interactive /system/bin/sh inside
#   linuxapk-session selftest      host-safety probes against the live session
#
# It runs from an installed prefix (libexec/linuxapk; in a checkout,
# out/stage after `mise run build`) and builds nothing. Its files:
#   $XDG_RUNTIME_DIR/linuxapk[-<instance>]/  pid files, the kmsg FIFO, the
#     bridge's socket, the start-time layer over the image
#   $XDG_STATE_HOME/linuxapk[-<instance>]/   logs (session, kmsg, bridge) and
#     the documents service's grants
#   $XDG_DATA_HOME/linuxapk/                 images/, data[-<instance>]/
#     (Android's /data), addons/ (layers over the partitions, e.g. microG)
#
# Environment: LINUXAPK_INSTANCE (default empty: the main session; set a name
#                to run an independent session, e.g. one per test),
#              LINUXAPK_DATA (default $XDG_DATA_HOME/linuxapk/data[-<instance>]),
#              LINUXAPK_AUDIO_SINK (PipeWire sink for the session's audio;
#                default: the desktop's default output),
#              LINUXAPK_BRIDGE_VERBOSE=1 (per-stream stats in bridge.log),
#              LINUXAPK_TEST=1 (a test session even without an instance),
#              LINUXAPK_OPEN_URLS=1 (a test session opens links in the host
#                browser; by default it only logs them, and it shows
#                notifications and media players only on a private bus),
#              LINUXAPK_SINGLE_UID=1 (same as start --single-uid),
#              LINUXAPK_BROKER_DEBUG=1 (broker tracing, and single-uid syscall
#                counters every 10 s, in session.log; another value is a log
#                file path inside the session root)
set -euo pipefail

die() {
  echo "linuxapk-session: $*" >&2
  exit 1
}

here=$(cd "$(dirname "$(realpath "$0")")" && pwd)
share=$(cd "$here/../.." && pwd)/share/linuxapk
[[ -f $share/manifest.tsv ]] || die "no staged build next to $here (run \`mise run build\`)"
inst=${LINUXAPK_INSTANCE:-}
[[ $inst =~ ^[a-z0-9-]*$ ]] || die "bad LINUXAPK_INSTANCE"
sfx=${inst:+-$inst}
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/linuxapk$sfx
state=${XDG_STATE_HOME:-$HOME/.local/state}/linuxapk$sfx
data_home=${XDG_DATA_HOME:-$HOME/.local/share}/linuxapk
data=${LINUXAPK_DATA:-$data_home/data$sfx}
unit=linuxapk-session$sfx

# The image: the pinned AOSP CI build's extracted partitions ($img), its
# flattened APEXes ($apexdir) and the layers derived from them ($derived).
# Our overrides are the staged Android tree (android/overlay and the built
# modules), the extra androidboot.* values (image/bootconfig) and the vendor
# properties (image/vendor.prop). See docs/image.md.
images=${LINUXAPK_IMAGES:-$data_home/images}
# The pin's top-level name: the keys before the first [table] header (the
# [[artifact]] tables have names of their own).
pin=${LINUXAPK_PIN:-$share/image/pin.toml}
image=$(awk -F'"' '/^[[:space:]]*\[/ { exit } /^name[[:space:]]*=/ { print $2; exit }' "$pin" 2>/dev/null || true)
[[ -n $image ]] || die "no image name in $pin"
# The extra androidboot.* values, one per line (e.g. the vendor APEX selection
# androidboot.vendor.apex.<name>=<file>|none, which apexd and
# image/flatten-apex.sh both honour).
image_bootconfig() {
  sed 's/#.*//' "$share/image/bootconfig" | tr -s ' \t' '\n' | grep .
}
# Shared by all instances, so each vendor APEX selection gets its own
# flattened tree (never rewritten under a running session).
img=$images/$image/img
apexdir=$images/$image/apex-$(image_bootconfig | grep '^androidboot\.vendor\.apex\.' | sha256sum | cut -c1-12)
derived=$images/$image/derived

# Map root to the invoking user (so image files appear root-owned), and the
# Android uid/gid ranges we need onto our subordinate ids:
#   1-29999 (system, AIDs, apps 10000-19999, app cache gids 20000-29999)
#   50000-59999 (shared app gids), 90000-99999 (isolated/app-zygote uids)
idmaps() {
  local kind=$1 who sub
  # Single-uid mode: only root, as the invoking user (docs/sandbox.md).
  if ((${single_uid:-0})); then
    if [[ $kind == users ]]; then echo "--map-users=0:$(id -u):1"; else echo "--map-groups=0:$(id -g):1"; fi
    return
  fi
  if [[ $kind == users ]]; then
    who=$(id -u)
    sub=/etc/subuid
  else
    who=$(id -g)
    sub=/etc/subgid
  fi
  local base count
  read -r base count < <(awk -F: -v u="$(id -un)" -v n="$(id -u)" \
    '$1==u || $1==n {print $2, $3; exit}' "$sub")
  [[ -n ${base:-} ]] || die "no entry for $(id -un) in $sub"
  ((count >= 49999)) || die "need at least 49999 subordinate ids in $sub (have $count)"
  echo "--map-$kind=0:$who:1 --map-$kind=1:$base:29999" \
    "--map-$kind=50000:$((base + 29999)):10000 --map-$kind=90000:$((base + 39999)):10000"
}

ns_pid() {
  [[ -f $run/pid ]] || return 1
  local p
  p=$(<"$run/pid")
  [[ -d /proc/$p ]] && echo "$p"
}

cmdline() {
  # androidboot.* (passed via /proc/bootconfig) become ro.boot.* properties.
  cat <<EOF
androidboot.hardware=linuxapk androidboot.selinux=permissive androidboot.verifiedbootstate=orange androidboot.veritymode=disabled androidboot.serialno=linuxapk0 androidboot.debuggable=1 androidboot.boot_devices=linuxapk androidboot.dalvik.vm.heapsize=512m
EOF
  image_bootconfig
}

# The start-time layer, $run/layer (top of every partition's stack, see
# ns-init.sh):
#   vendor/build.prop  the image's, plus every props.d/*.prop (graphics,
#                      audio), the driver selection and image/vendor.prop.
#                      RADV only if the render node is driven by amdgpu,
#                      else lavapipe.
#   apex/<name>/       our files for the APEXes this image has (the stage's,
#                      then the addons'), so the tree gains no directories
#                      apexd and linkerconfig don't know about.
runtime_layer() {
  local layer=$run/layer drv vk=lvp ours p src d
  [[ -f $share/props.d/vulkan.prop ]] || die "no graphics properties ($share/props.d/vulkan.prop)"
  drv=$(basename "$(readlink -f /sys/class/drm/renderD128/device/driver 2>/dev/null)")
  [[ $drv == amdgpu ]] && vk=radv
  ours=$(
    for p in "$share"/props.d/*.prop; do
      echo "# --- linuxapk-session: $(basename "$p") ---"
      grep -v '^#' "$p"
    done
    echo "# --- linuxapk-session: render node driver: ${drv:-none} ---"
    echo "ro.hardware.vulkan=$vk"
    # Composer backend: windows through the bridge, or none.
    echo "vendor.linuxapk.hwc.backend=$hwc_backend"
    echo "# --- linuxapk-session: image/vendor.prop ---"
    cat "$share/image/vendor.prop"
  )
  mkdir -p "$layer/vendor" "$layer/apex"
  {
    # The image's file minus every key set here, so ours take effect.
    awk -F= 'NR == FNR { if ($0 !~ /^#/ && NF > 1) mine[$1] = 1; next } !($1 in mine)' \
      <(echo "$ours") "$img/vendor/build.prop"
    echo
    echo "$ours"
  } >"$layer/vendor/build.prop"
  chmod 0644 "$layer/vendor/build.prop"
  for src in "$share/android/apex" "$data_home"/addons/*/apex; do
    for d in "$src"/*/; do
      [[ -d $d && -d $apexdir/$(basename "$d") ]] && cp -a "$d" "$layer/apex/"
    done
  done
  return 0
}

# /data's files belong to Android's uids: subordinate ids normally, the
# invoking user in single-uid mode. Booting a data dir made in the other mode
# leaves apps without access to their files, so refuse.
check_data_owner() {
  [[ -d $data/system ]] || return 0
  local owner
  owner=$(stat -c %u "$data/system")
  if ((single_uid)) && [[ $owner != "$(id -u)" ]]; then
    die "$data was made by a normal (subuid) session; use a fresh LINUXAPK_DATA for --single-uid"
  elif ((! single_uid)) && [[ $owner == "$(id -u)" ]]; then
    die "$data was made by a --single-uid session; pass --single-uid or use a fresh LINUXAPK_DATA"
  fi
}

# Make sure the selected image is extracted and flattened, and its derived
# layers (image/derive.sh) are current: the common one and the one for this
# uid mode.
prepare() {
  local single=${1:-0} layer want
  [[ -d $img/system/system ]] || "$here/image/fetch.sh" "$pin"
  if [[ ! -f $apexdir/apex-info-list.xml ]]; then
    rm -rf "$apexdir.tmp$sfx"
    "$here/image/flatten-apex.sh" "$img" "$share/image/bootconfig" "$apexdir.tmp$sfx"
    mv -T "$apexdir.tmp$sfx" "$apexdir" 2>/dev/null || rm -rf "$apexdir.tmp$sfx" # lost a race: fine
  fi
  for layer in common "$( ((single)) && echo single-uid || echo subuid)"; do
    want="$apexdir $(sha256sum <"$here/image/derive.sh")"
    [[ $(cat "$derived/$layer.source" 2>/dev/null) == "$want" ]] && continue
    rm -f "$derived/$layer.source"
    "$here/image/derive.sh" "$layer" "$img" "$apexdir" "$derived/$layer"
    echo "$want" >"$derived/$layer.source"
  done
}

start() {
  local fg=0 wayland=""
  # Windows go through the bridge's display service; --headless shows none.
  hwc_backend=bridge single_uid=0
  [[ ${LINUXAPK_SINGLE_UID:-} == 1 ]] && single_uid=1
  for a in "$@"; do
    case $a in
      -f) fg=1 ;;
      --headless) hwc_backend=headless ;;
      --single-uid) single_uid=1 ;;
      *) die "unknown start option: $a" ;;
    esac
  done
  check_data_owner
  if [[ $hwc_backend != headless ]]; then
    # The host compositor's socket, for the bridge's display service.
    local wd=${WAYLAND_DISPLAY:-$(systemctl --user show-environment | sed -n 's/^WAYLAND_DISPLAY=//p')}
    local xrd=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    [[ $wd == /* ]] && wayland=$wd || wayland=$xrd/${wd:-wayland-0}
    [[ -S $wayland ]] || die "no Wayland socket at $wayland (use --headless)"
  fi
  if p=$(ns_pid); then die "already running (pid $p)"; fi
  prepare "$single_uid"

  rm -rf "$run"
  mkdir -p "$run" "$state"
  : >"$state/session.log"
  : >"$state/kmsg.log"
  : >"$state/bridge.log"
  runtime_layer
  echo "console=null" >"$run/cmdline"
  cmdline | tr ' ' '\n' | sed -n 's/^\(androidboot\.[^=]*\)=\(.*\)/\1 = "\2"/p' >"$run/bootconfig"
  mkfifo "$run/kmsg"

  # Everything (log reader, unshare, the namespace) runs in one transient
  # systemd user service, so it outlives this shell and "stop" can take it
  # all down. Delegate=yes gives the session a cgroup subtree of its own.
  # The bridge's desktop integration (docs/bridge.md, "System service") uses
  # the caller's session bus, and desktop entries for apps installed inside
  # Android ("Apps service") go to the caller's XDG_DATA_HOME.
  local integ_env=() v
  for v in DBUS_SESSION_BUS_ADDRESS XDG_DATA_HOME; do
    [[ -n ${!v:-} ]] && integ_env+=("--setenv=$v=${!v}")
  done
  # Test sessions (any named instance, or LINUXAPK_TEST=1: lanes, the compat
  # runner) never reach the user's real desktop: links are only logged (unless
  # LINUXAPK_OPEN_URLS=1), and so are notifications and media players unless
  # the session talks to a private bus (a nested test desktop).
  local quiet=()
  if [[ -n $inst || ${LINUXAPK_TEST:-} == 1 ]]; then
    [[ ${LINUXAPK_OPEN_URLS:-} == 1 ]] || quiet+=(--no-open-urls)
    local bus=${DBUS_SESSION_BUS_ADDRESS:-}
    [[ -n $bus && $bus != "unix:path=/run/user/$(id -u)/bus" ]] || quiet+=(--no-desktop-presence)
  fi
  integ_env+=("--setenv=LINUXAPK_BRIDGE_QUIET=${quiet[*]}")
  systemd-run --user --quiet --collect --unit="$unit" -p Delegate=yes -p KillMode=control-group \
    -p MemoryHigh=6G -p MemoryMax=8G -p MemorySwapMax=0 \
    --setenv=LINUXAPK_INSTANCE="$inst" --setenv=LINUXAPK_WAYLAND="$wayland" \
    --setenv=LINUXAPK_AUDIO_SINK="${LINUXAPK_AUDIO_SINK:-}" --setenv=LINUXAPK_BRIDGE_VERBOSE="${LINUXAPK_BRIDGE_VERBOSE:-}" \
    --setenv=LINUXAPK_PIN="$pin" --setenv=LINUXAPK_IMAGES="$images" \
    --setenv=LINUXAPK_BROKER_DEBUG="${LINUXAPK_BROKER_DEBUG:-}" --setenv=LINUXAPK_SINGLE_UID="$single_uid" \
    "${integ_env[@]}" -- "$here/linuxapk-session" _run "$run" "$state" "$data"
  # _run records the pids once Android init is up.
  for _ in $(seq 100); do
    [[ -s $run/pid ]] && break
    systemctl --user -q is-active "$unit" || break
    sleep 0.1
  done
  local p
  p=$(ns_pid) || {
    cat "$state/session.log" >&2
    die "session failed to start"
  }
  echo "session started ($image): Android pid 1 = host pid $p; log: $state/kmsg.log"
  if ((fg)); then
    tail -n +1 --pid="$p" -f "$state/kmsg.log" || true
  fi
  return 0
}

# The desktop bridge runs on the host (glibc, outside the namespaces) in
# this unit's cgroup, so "stop" ends it too, restarted if it exits. Its
# socket directory is bound into the session as /dev/socket/linuxapk
# (root:audio 0750, see ns-init.sh), and the bridge only accepts Android
# root, system and audioserver (SO_PEERCRED, as host ids), plus the Linux.apk
# System app's uid (the owner of its data directory) for the system service.
# docs/bridge.md.
start_bridge() {
  local base
  mkdir -p "$run/bridge"
  local args=(--run-dir "$run" --state-dir "$state" --allow-uid "$(id -u)")
  if [[ ${LINUXAPK_SINGLE_UID:-} != 1 ]]; then
    # AID_SYSTEM 1000 and AID_AUDIOSERVER 1041 map to base + id - 1. (In
    # single-uid mode every Android process is the invoking user.)
    read -r base _ < <(awk -F: -v u="$(id -un)" -v n="$(id -u)" '$1==u || $1==n {print $2, $3; exit}' /etc/subuid)
    args+=(--allow-uid $((base + 999)) --allow-uid $((base + 1040)))
  fi
  args+=(--system-app-dir "$data/data/dev.linuxapk.system"
    ${LINUXAPK_AUDIO_SINK:+--sink "$LINUXAPK_AUDIO_SINK"})
  [[ ${LINUXAPK_BRIDGE_VERBOSE:-} == 1 ]] && args+=(-v)
  # Apps installed inside the main session get desktop entries.
  [[ -n $inst ]] || args+=(--mirror-apps)
  # Log-only sinks for test sessions (see start).
  local q
  for q in ${LINUXAPK_BRIDGE_QUIET:-}; do
    case $q in --no-open-urls | --no-desktop-presence) args+=("$q") ;; esac
  done
  while :; do
    # The display service (windows, input) and the clipboard connect to the
    # host compositor.
    WAYLAND_DISPLAY=${LINUXAPK_WAYLAND:-} "$here/linuxapk-bridge" "${args[@]}" </dev/null >>"$state/bridge.log" 2>&1
    echo "linuxapk-session: bridge exited ($?); restarting" >>"$state/bridge.log"
    sleep 1
  done &
  for _ in $(seq 50); do
    [[ -S $run/bridge/bridge.sock ]] && return 0
    sleep 0.02
  done
  return 1
}

# Body of the systemd service (internal).
_run() {
  run=$1 state=$2 data=$3
  single_uid=0
  [[ ${LINUXAPK_SINGLE_UID:-} == 1 ]] && single_uid=1
  # Reader holds the FIFO open read-write so writers never block or see EOF.
  cat 0<>"$run/kmsg" >>"$state/kmsg.log" &
  # start shows session.log when the session fails to come up.
  start_bridge || {
    echo "the bridge did not start (see $state/bridge.log)" >>"$state/session.log"
    return 1
  }
  # Outer namespaces: user (subuid map), mount, pid, cgroup. pivot-exec then
  # nests user/mount/pid/cgroup/net/ipc/uts namespaces for Android itself.
  # shellcheck disable=SC2046
  env LINUXAPK_RUN="$run" LINUXAPK_DATA="$data" LINUXAPK_IMG="$img" LINUXAPK_APEX="$apexdir" \
    LINUXAPK_DERIVED="$derived" LINUXAPK_ADDONS="$data_home/addons" LINUXAPK_SINGLE_UID="$single_uid" \
    unshare $(idmaps users) $(idmaps groups) --mount --pid --cgroup --fork --kill-child \
    -- "$here/ns-init.sh" </dev/null >>"$state/session.log" 2>&1 &
  local ushare=$! outer="" inner=""
  for _ in $(seq 200); do
    [[ -z $outer ]] && outer=$(pgrep -P "$ushare" | head -1 || true)
    [[ -n $outer ]] && inner=$(pgrep -P "$outer" -x 'init|sh' | head -1 || true)
    [[ -n $inner ]] && break
    kill -0 "$ushare" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -n $inner ]]; then
    echo "$outer" >"$run/outer.pid"
    echo "$inner" >"$run/pid"
    # User-mode networking for the session's own network namespace. No
    # inbound port forwarding, and --no-map-gw keeps the host's loopback
    # services unreachable from Android. Android's EthernetService brings eth1
    # up (DHCP from pasta) as the default network, with default capabilities
    # since the image's connectivity overlay is blanked (docs/image.md). DHCP
    # hands out 169.254.1.1 as the resolver, which pasta forwards to the host's
    # first IPv4 nameserver (with -D, pasta no longer picks it by itself).
    local dns_host
    dns_host=$(awk '$1 == "nameserver" && $2 !~ /:/ {print $2; exit}' /etc/resolv.conf 2>/dev/null || true)
    pasta --config-net --quiet --foreground --no-netns-quit --no-map-gw -I eth1 \
      -D 169.254.1.1 --dhcp-dns --dns-forward 169.254.1.1 ${dns_host:+--dns-host "$dns_host"} \
      -t none -u none -T none -U none \
      --userns "/proc/$inner/ns/user" --netns "/proc/$inner/ns/net" >>"$state/session.log" 2>&1 &
    echo $! >"$run/pasta.pid"
  fi
  wait "$ushare"
  [[ -f $run/pasta.pid ]] && kill "$(<"$run/pasta.pid")" 2>/dev/null
  return 0
}

stop() {
  local p
  for f in outer.pid pid; do
    [[ -f $run/$f ]] && p=$(<"$run/$f") && [[ -d /proc/$p ]] && kill -KILL "$p" 2>/dev/null
  done
  systemctl --user stop "$unit" 2>/dev/null || true
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  for _ in $(seq 50); do
    [[ $(systemctl --user show -P LoadState "$unit" 2>/dev/null) == not-found ]] && break
    sleep 0.1
  done
  rm -f "$run/pid" "$run/outer.pid"
  echo "session stopped"
}

status() {
  if p=$(ns_pid); then echo "running: host pid $p"; else
    echo "stopped"
    return 1
  fi
}

# Run a command inside the session (root in the user ns), with the Android
# environment from init.environ.rc and the derived classpath.
exec_in() {
  local p
  p=$(ns_pid) || die "not running"
  # Join the session's own cgroup so nothing started here outlives "stop".
  local cg
  cg=$(systemctl --user show -P ControlGroup "$unit")
  [[ -n $cg ]] && echo $$ >"/sys/fs/cgroup$cg/cgroup.procs"
  # shellcheck disable=SC2016 # expanded by the session's shell
  exec nsenter -t "$p" -U -m -p -C -n -i -u --preserve-credentials -r -w \
    /system/bin/sh -c '
      for f in /init.environ.rc /data/system/environ/classpath; do
        [ -r "$f" ] && eval "$(sed -n "s/^ *export \([^ ]*\) \(.*\)/export \1=\"\2\"/p" "$f")"
      done
      export PATH=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin
      export HOME=/data/local/tmp TMPDIR=/data/local/tmp
      cd /
      # Binder needs the seccomp filter that only descendants of init have,
      # so run the command through the exec relay.
      exec /system/bin/linuxapk-exec "$@"' sh "$@"
}

# selftest's group probes for a single-uid session (pid 1 = $1).
single_uid_groups() {
  local p=$1 g extra=() bad=""
  local groups
  read -ra groups < <(sed -n 's/^Groups:[[:space:]]*//p' "/proc/$p/status")
  for g in "${groups[@]}"; do
    [[ $g == "$(id -g)" ]] || extra+=("$g")
  done
  if [[ $(<"/proc/$p/setgroups") == deny ]]; then
    echo "ok   single-uid: setgroups denied in the session"
  else
    echo "FAIL single-uid: setgroups allowed in the session"
  fi
  if ((${#extra[@]} == 0)); then
    echo "ok   no host supplementary groups"
    return
  fi
  if awk -v g="${extra[*]}" 'BEGIN { n = split(g, a, " ") } { for (i = 1; i <= n; i++) if ($1 <= a[i] && a[i] < $1 + $3) bad = 1 } END { exit !bad }' "/proc/$p/gid_map"; then
    echo "FAIL single-uid: a host supplementary group is mapped"
  else
    echo "ok   single-uid: host supplementary groups (${extra[*]}) unmapped"
  fi
  # The host paths bound into the session (ns-init.sh): /data, the device
  # nodes, the kmsg FIFO and the bridge's socket directory.
  local paths=("$data" "$run/kmsg" "$run/bridge") n
  for n in null zero full random urandom fuse udmabuf net/tun dri; do
    [[ -e /dev/$n ]] && paths+=("/dev/$n")
  done
  for g in "${extra[@]}"; do
    bad+=$(find "${paths[@]}" -xdev -group "$g" -print -quit 2>/dev/null)
  done
  if [[ -z $bad ]]; then
    echo "ok   single-uid: no bound host path belongs to them"
  else
    echo "FAIL single-uid: bound host path owned by a host group: $bad"
  fi
}

# Host-safety probes against a live session; each must report "ok".
selftest() {
  local p
  p=$(ns_pid) || die "not running"
  {
    [[ $(readlink "/proc/$p/ns/net") != $(readlink /proc/self/ns/net) ]] &&
      echo "ok   own network namespace" || echo "FAIL shares the host network namespace"
    [[ $(readlink "/proc/$p/ns/ipc") != $(readlink /proc/self/ns/ipc) ]] &&
      echo "ok   own IPC namespace" || echo "FAIL shares the host IPC namespace"
    grep -q "/$unit.service" "/proc/$p/cgroup" &&
      echo "ok   runs in $unit.service's cgroup" || echo "FAIL cgroup: $(cat "/proc/$p/cgroup")"
    if [[ $(wc -l <"/proc/$p/uid_map") == 1 ]]; then
      # Single-uid mode (docs/sandbox.md): without a subgid range the
      # kernel denies setgroups, so the host user's supplementary groups
      # can't be dropped. Check that they stay unusable instead: setgroups
      # is denied (no way to change them), they're unmapped inside, and no
      # host path bound into the session belongs to one of them.
      single_uid_groups "$p"
    else
      grep -Eq '^Groups:[[:space:]]*$' "/proc/$p/status" &&
        echo "ok   no host supplementary groups" || echo "FAIL $(grep ^Groups "/proc/$p/status")"
    fi
    # shellcheck disable=SC2016 # expanded by the session's shell
    "$0" exec /system/bin/sh -c '
      t() { if eval "$2" >/dev/null 2>&1; then echo "FAIL $1"; else echo "ok   $1"; fi; }
      t "umount of the fusectl mask refused" "umount /sys/fs/fuse/connections"
      t "lazy umount of a /sys mask refused" "umount -l /sys/firmware/efi/efivars"
      t "remount /sys rw refused" "mount -o remount,bind,rw /sys"
      t "sysfs not writable" "echo 1 > /sys/kernel/mm/ksm/run"
      t "no FUSE connections visible" "[ -n \"\$(ls -A /sys/fs/fuse/connections)\" ]"
      t "fresh sysfs mount refused" "mkdir -p /tmp/.st && mount -t sysfs s /tmp/.st"
      t "sysrq refused" "echo h > /proc/sysrq-trigger"
      t "umount of the staged APEX tree refused" "umount /linuxapk/apex"
    ' 2>&1 | grep -v 'linker'
  } >"$run/selftest.txt"
  cat "$run/selftest.txt"
  ! grep -q FAIL "$run/selftest.txt"
}

case ${1:-} in
  start)
    shift
    start "$@"
    ;;
  stop) stop ;;
  prepare) prepare "$([[ ${LINUXAPK_SINGLE_UID:-} == 1 ]] && echo 1 || echo 0)" ;;
  image) printf 'image=%s\nimg=%s\napex=%s\n' "$image" "$img" "$apexdir" ;;
  _run)
    shift
    _run "$@"
    ;;
  status) status ;;
  selftest) selftest ;;
  log)
    shift
    if [[ ${1:-} == -f ]]; then exec tail -n +1 -f "$state/kmsg.log"; else cat "$state/kmsg.log"; fi
    ;;
  exec)
    shift
    (($#)) || die "usage: exec CMD..."
    exec_in "$@"
    ;;
  shell) exec_in /system/bin/sh -l ;;
  *)
    sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p}' "$0"
    exit 1
    ;;
esac
