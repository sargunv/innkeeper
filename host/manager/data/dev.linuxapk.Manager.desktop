[Desktop Entry]
Type=Application
Version=1.5
Name=Linux.apk
GenericName=Android App Manager
Comment=Install, run and remove Android apps
Icon=dev.linuxapk.Manager
Exec=linuxapk open %F
Terminal=false
StartupNotify=true
StartupWMClass=dev.linuxapk.Manager
MimeType=application/vnd.android.package-archive;application/x-android-apks;application/x-android-xapk;application/x-android-apkm;application/pdf;application/epub+zip;application/zip;application/json;application/rtf;application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.ms-excel;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-powerpoint;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.spreadsheet;application/vnd.oasis.opendocument.presentation;text/plain;text/markdown;text/csv;text/html;text/xml;image/jpeg;image/png;image/gif;image/webp;image/svg+xml;image/bmp;audio/mpeg;audio/mp4;audio/ogg;audio/flac;audio/wav;video/mp4;video/webm;video/x-matroska;
Categories=System;PackageManager;
Keywords=Android;APK;
