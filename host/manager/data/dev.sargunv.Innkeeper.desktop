[Desktop Entry]
Type=Application
Version=1.5
Name=Innkeeper
GenericName=Android App Manager
Comment=Run Android apps on Linux
Icon=dev.sargunv.Innkeeper
Exec=innkeeper-manager %F
Terminal=false
StartupNotify=true
StartupWMClass=dev.sargunv.Innkeeper
MimeType=application/vnd.android.package-archive;application/x-android-apks;application/x-android-xapk;application/x-android-apkm;
Categories=System;PackageManager;
Keywords=Android;APK;
