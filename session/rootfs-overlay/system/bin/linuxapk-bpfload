#!/system/bin/sh
# Wrapper for netbpfload in a Linux.apk session (see the tethering APEX's
# netbpfload.35rc override). Runs in its own mount namespace. netbpfload
# writes /proc/sys/kernel/unprivileged_bpf_disabled and
# /proc/sys/net/core/bpf_jit_{enable,kallsyms}; in our user and network
# namespaces the first is read-only and the others don't exist, so give it
# writable stand-ins (only it can see them).
d=/dev/.linuxapk-bpfload
mkdir -p $d/core
echo 2 > $d/unprivileged_bpf_disabled
echo 1 > $d/core/bpf_jit_enable
echo 0 > $d/core/bpf_jit_kallsyms
mount --bind $d/unprivileged_bpf_disabled /proc/sys/kernel/unprivileged_bpf_disabled
mount --bind $d/core /proc/sys/net/core
exec /apex/com.android.tethering/bin/netbpfload "$@"
