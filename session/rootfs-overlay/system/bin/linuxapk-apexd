#!/system/bin/sh
# Wrapper for apexd in a Linux.apk session (see /system/etc/init/apexd.rc).
# Runs in its own mount namespace. apexd rebuilds its database of mounted
# APEXes from /proc/mounts at startup; append an entry per pre-mounted APEX
# (generated by the session launcher) in the form apexd uses for erofs
# file-backed mounts, then exec apexd with the same pid.
cat /proc/self/mounts /linuxapk/apexd-mounts >/dev/.linuxapk-apexd-mounts
mount --bind /dev/.linuxapk-apexd-mounts /proc/$$/mounts
exec /system/bin/apexd "$@"
