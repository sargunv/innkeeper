#!/usr/bin/env bash
# Linux.apk session launcher: boots an Android image (LINUXAPK_IMAGE) in a
# rootless user + mount + pid + cgroup namespace.
#
#   linuxapk-session start [-f] [--headless] [--single-window]
#                                  boot (in the background unless -f). Each
#                                  app gets its own host Wayland window
#                                  (docs/windowing.md); --single-window shows
#                                  all of Android in one window instead, and
#                                  --headless opens no windows
#   linuxapk-session prepare       fetch/extract/flatten the selected image only
#   linuxapk-session image         print the selected image and its paths
#   linuxapk-session stop          kill the session (its pid 1) and clean up
#   linuxapk-session status
#   linuxapk-session log [-f]      Android init's kernel log (/dev/kmsg)
#   linuxapk-session exec CMD...   run CMD inside the live session as root
#   linuxapk-session shell         interactive /system/bin/sh inside
#   linuxapk-session selftest      host-safety probes against the live session
#
# Environment: LINUXAPK_OUT (default <repo>/out),
#              LINUXAPK_INSTANCE (default empty: the main session; set a name
#                to run an independent session, e.g. one per agent lane),
#              LINUXAPK_DATA (default ~/.local/share/linuxapk/data[-<instance>]),
#              LINUXAPK_AUDIO_SINK (PipeWire sink for the session's audio;
#                default: the desktop's default output),
#              LINUXAPK_BRIDGE_VERBOSE=1 (per-stream stats in run/bridge.log),
#              LINUXAPK_IMAGE (default: the pin in image/pin.toml):
#                ci-<build>  AOSP CI cuttlefish build (tools/fetch-image.sh)
#                emulator    SDK emulator image in out/img (tools/extract-image.sh)
set -euo pipefail

here=$(cd "$(dirname "$(realpath "$0")")" && pwd)
repo=$(dirname "$here")
out=${LINUXAPK_OUT:-$repo/out}
out=$(realpath "$out")
inst=${LINUXAPK_INSTANCE:-}
[[ $inst =~ ^[a-z0-9-]*$ ]] || {
  echo "linuxapk-session: bad LINUXAPK_INSTANCE" >&2
  exit 1
}
sfx=${inst:+-$inst}
run=$out/run$sfx
data=${LINUXAPK_DATA:-$HOME/.local/share/linuxapk/data$sfx}
unit=linuxapk-session$sfx

die() {
  echo "linuxapk-session: $*" >&2
  exit 1
}

# Image selection. Each image is a set of extracted partitions ($img), its
# flattened APEXes ($apexdir), and a kind whose overrides live in
# session/image-overlay/<kind>/ (rootfs layers plus extra androidboot.* in
# "cmdline"), layered above session/rootfs-overlay. See docs/image.md.
images=${LINUXAPK_IMAGES:-$HOME/.local/share/linuxapk/images}
# The pin's top-level name: the keys before the first [table] header (the
# [[artifact]] tables have names of their own).
pin=${LINUXAPK_PIN:-$repo/image/pin.toml}
pinned=$(awk -F'"' '/^[[:space:]]*\[/ { exit } /^name[[:space:]]*=/ { print $2; exit }' "$pin" 2>/dev/null || true)
image=${LINUXAPK_IMAGE:-${pinned:-emulator}}
case $image in
  emulator) kind=emulator ;;
  ci-[0-9]*) kind=cuttlefish ;;
  *) die "unknown LINUXAPK_IMAGE: $image (ci-<build> or emulator)" ;;
esac
kind_ovl=$repo/session/image-overlay/$kind
# Extra androidboot.* for this kind, one per line (e.g. the vendor APEX
# selection androidboot.vendor.apex.<name>=<file>|none, which apexd and
# tools/flatten-apex.sh both honour).
kind_cmdline() {
  [[ -f $kind_ovl/cmdline ]] || return 0
  sed 's/#.*//' "$kind_ovl/cmdline" | tr -s ' \t' '\n' | grep . || true
}
if [[ $kind == emulator ]]; then
  img=$out/img apexdir=$out/root/apex
else
  # Shared by all checkouts and instances, so each vendor APEX selection gets
  # its own flattened tree (never rewritten under a running session).
  img=$images/$image/img
  apexdir=$images/$image/apex-$(kind_cmdline | grep '^androidboot\.vendor\.apex\.' | sha256sum | cut -c1-12)
fi

# Map root to the invoking user (so image files appear root-owned), and the
# Android uid/gid ranges we need onto our subordinate ids:
#   1-29999 (system, AIDs, apps 10000-19999, app cache gids 20000-29999)
#   50000-59999 (shared app gids), 90000-99999 (isolated/app-zygote uids)
idmaps() {
  local kind=$1 who sub
  if [[ $kind == users ]]; then
    who=$(id -u)
    sub=/etc/subuid
  else
    who=$(id -g)
    sub=/etc/subgid
  fi
  local base count
  read -r base count < <(awk -F: -v u="$(id -un)" -v n="$(id -u)" \
    '$1==u || $1==n {print $2, $3; exit}' "$sub")
  [[ -n ${base:-} ]] || die "no entry for $(id -un) in $sub"
  ((count >= 49999)) || die "need at least 49999 subordinate ids in $sub (have $count)"
  echo "--map-$kind=0:$who:1 --map-$kind=1:$base:29999" \
    "--map-$kind=50000:$((base + 29999)):10000 --map-$kind=90000:$((base + 39999)):10000"
}

ns_pid() {
  [[ -f $run/pid ]] || return 1
  local p
  p=$(<"$run/pid")
  [[ -d /proc/$p ]] && echo "$p"
}

cmdline() {
  # androidboot.* (passed via /proc/bootconfig) become ro.boot.* properties.
  # linuxapk.ubinder gates the binderfs mount in init.rc (0 = kernel binder).
  cat <<EOF
androidboot.hardware=linuxapk androidboot.selinux=permissive androidboot.verifiedbootstate=orange androidboot.veritymode=disabled androidboot.serialno=linuxapk0 androidboot.debuggable=1 androidboot.boot_devices=linuxapk androidboot.dalvik.vm.heapsize=512m androidboot.linuxapk.ubinder=${ubinder:-0}
EOF
  kind_cmdline
}

# /vendor/build.prop = the image's plus graphics driver selection from
# out/vendor-overlay/etc/gpu.prop (gpu lane). RADV only if the render node is
# driven by amdgpu, else lavapipe.
vendor_props() {
  local dst=$out/session/overlay/vendor/build.prop gpu=$out/vendor-overlay/etc/gpu.prop vk=lvp
  local drv ours
  drv=$(basename "$(readlink -f /sys/class/drm/renderD128/device/driver 2>/dev/null)")
  [[ $drv == amdgpu ]] && vk=radv
  mkdir -p "$(dirname "$dst")"
  ours=$(
    echo "# --- linuxapk-session: graphics (render node driver: ${drv:-none}) ---"
    if [[ -f $gpu ]]; then
      grep -v '^ro.hardware.vulkan=' "$gpu"
    else
      printf 'ro.hardware.egl=angle\nro.opengles.version=196610\n'
    fi
    echo "ro.hardware.vulkan=$vk"
    # The default 256 KiB main buffer wraps within seconds of boot.
    echo "ro.logd.size=16M"
    # Composer backend (hal lane): a window on the host compositor, or none.
    echo "vendor.linuxapk.hwc.backend=$hwc_backend"
    # Windowing (docs/windowing.md): a window per app, or display 0 as one.
    echo "vendor.linuxapk.wm.mode=$wm_mode"
    # Audio (audio lane): tinyalsa buffer sizing for the bridge-backed card.
    if [[ -f $out/vendor-overlay/etc/audio.prop ]]; then
      echo "# --- linuxapk-session: audio ---"
      grep -v '^#' "$out/vendor-overlay/etc/audio.prop"
    fi
    # Per-image-kind vendor properties (session/image-overlay/<kind>/vendor.prop).
    if [[ -f $kind_ovl/vendor.prop ]]; then
      echo "# --- linuxapk-session: $kind ---"
      cat "$kind_ovl/vendor.prop"
    fi
  )
  {
    # The image's file minus every key set here, so ours take effect.
    awk -F= 'NR == FNR { if ($0 !~ /^#/ && NF > 1) mine[$1] = 1; next } !($1 in mine)' \
      <(echo "$ours") "$img/vendor/build.prop"
    echo
    echo "$ours"
  } >"$dst"
  chmod 0644 "$dst"
}

# Make sure the selected image is extracted and flattened, and the generated
# overlay matches it.
prepare() {
  if [[ ! -d $img/system/system ]]; then
    [[ $kind == emulator ]] && die "no image at $img (run tools/extract-image.sh)"
    [[ $image == "$pinned" ]] || die "no image at $img (pin it in image/pin.toml and run tools/fetch-image.sh)"
    "$repo/tools/fetch-image.sh"
  fi
  if [[ ! -f $apexdir/apex-info-list.xml ]]; then
    mkdir -p "$out/session"
    kind_cmdline >"$out/session/apex-select"
    rm -rf "$apexdir.tmp$sfx"
    "$repo/tools/flatten-apex.sh" "$img" "$apexdir.tmp$sfx" "$out/session/apex-select"
    mv -T "$apexdir.tmp$sfx" "$apexdir" 2>/dev/null || rm -rf "$apexdir.tmp$sfx" # lost a race: fine
  fi
  # A stable name for the last-prepared tree, for tools that link against
  # image libraries (e.g. audio/build.sh); sessions use $apexdir itself.
  if [[ $kind != emulator ]]; then ln -sfn "$(basename "$apexdir")" "$images/$image/apex"; fi
  # build.sh's generated overlay holds image-derived files (relaxed copies,
  # APEX fs_config), so rebuild it when the image changes too.
  if [[ ! -x $out/session/pivot-exec ]] ||
    [[ "$img $apexdir" != "$(cat "$out/session/overlay/.image" 2>/dev/null)" ]] ||
    [[ -n $(find "$here/shim" "$here/helper" "$here/build.sh" "$repo/ubinder/src" -newer "$out/session/pivot-exec" 2>/dev/null) ]]; then
    LINUXAPK_IMG=$img LINUXAPK_APEX=$apexdir "$here/build.sh"
    echo "$img $apexdir" >"$out/session/overlay/.image"
  fi
}

start() {
  local fg=0 wayland=""
  # Windows go through the bridge's display service (the composer falls back
  # to the host Wayland socket itself); LINUXAPK_HWC_BACKEND=wayland skips
  # the bridge.
  hwc_backend=${LINUXAPK_HWC_BACKEND:-bridge} wm_mode=per-app
  ubinder=0
  for a in "$@"; do
    case $a in
      -f) fg=1 ;;
      --headless) hwc_backend=headless ;;
      --single-window) wm_mode=single ;;
      --ubinder) ubinder=1 ;;
      *) die "unknown start option: $a" ;;
    esac
  done
  if [[ $hwc_backend != headless ]]; then
    # Only the host compositor's socket file goes in (as
    # /dev/socket/wayland-host), never all of $XDG_RUNTIME_DIR.
    local wd=${WAYLAND_DISPLAY:-$(systemctl --user show-environment | sed -n 's/^WAYLAND_DISPLAY=//p')}
    local xrd=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    [[ $wd == /* ]] && wayland=$wd || wayland=$xrd/${wd:-wayland-0}
    [[ -S $wayland ]] || die "no Wayland socket at $wayland (use --headless)"
  fi
  if p=$(ns_pid); then die "already running (pid $p)"; fi
  prepare

  # The desktop bridge (audio to PipeWire; bridge/, Rust). Optional: without
  # it Android still boots, with audio going nowhere.
  local bridge=$repo/target/release/linuxapk-bridge
  if [[ ! -x $bridge ]] || [[ -n $(find "$repo/bridge" -newer "$bridge" -name '*.rs' 2>/dev/null) ]]; then
    (cd "$repo" && cargo build -q --release -j 8 -p linuxapk-bridge) || echo "linuxapk-session: bridge build failed; no audio" >&2
  fi
  if ((ubinder)) && [[ ! -x $out/session/overlay/system/bin/linuxapk-ubinder ]]; then
    die "ubinder helper not built (need cargo; see session/build.sh)"
  fi

  # iptables with the nf_tables backend (the image's legacy one can't work).
  [[ -x $out/session/iptables/system/bin/xtables-nft-multi ]] || "$here/iptables/build.sh"
  vendor_props

  rm -rf "$run"
  mkdir -p "$run"
  echo "console=null" >"$run/cmdline"
  cmdline | tr ' ' '\n' | sed -n 's/^\(androidboot\.[^=]*\)=\(.*\)/\1 = "\2"/p' >"$run/bootconfig"
  mkfifo "$run/kmsg"

  # Everything (log reader, unshare, the namespace) runs in one transient
  # systemd user service, so it outlives this shell and "stop" can take it
  # all down. Delegate=yes gives the session a cgroup subtree of its own.
  local ubinder_helper=""
  ((ubinder)) && ubinder_helper=/system/bin/linuxapk-ubinder
  systemd-run --user --quiet --collect --unit="$unit" -p Delegate=yes -p KillMode=control-group \
    -p "MemoryHigh=${LINUXAPK_MEMORY_HIGH:-6G}" -p "MemoryMax=${LINUXAPK_MEMORY_MAX:-8G}" -p MemorySwapMax=0 \
    --setenv=LINUXAPK_INSTANCE="$inst" --setenv=LINUXAPK_HOLD="${LINUXAPK_HOLD:-}" --setenv=LINUXAPK_WAYLAND="$wayland" \
    --setenv=LINUXAPK_AUDIO_SINK="${LINUXAPK_AUDIO_SINK:-}" --setenv=LINUXAPK_BRIDGE_VERBOSE="${LINUXAPK_BRIDGE_VERBOSE:-}" \
    --setenv=LINUXAPK_IMAGE="$image" --setenv=LINUXAPK_IMAGES="$images" \
    --setenv=LINUXAPK_UBINDER="$ubinder_helper" --setenv=LINUXAPK_UBINDER_DEBUG="${LINUXAPK_UBINDER_DEBUG:-}" \
    -- "$here/linuxapk-session" _run "$out" "$data"
  # _run records the pids once Android init (or the hold process) is up.
  for _ in $(seq 100); do
    [[ -s $run/pid ]] && break
    systemctl --user -q is-active "$unit" || break
    sleep 0.1
  done
  local p
  p=$(ns_pid) || {
    cat "$run/session.out" >&2
    die "session failed to start"
  }
  echo "session started ($image): Android pid 1 = host pid $p; log: $run/kmsg.log"
  if ((fg)); then
    tail -n +1 --pid="$p" -f "$run/kmsg.log" || true
  fi
  return 0
}

# The desktop bridge runs on the host (glibc, outside the namespaces) in
# this unit's cgroup, so "stop" ends it too, restarted if it exits. Its
# socket directory is bound into the session as /dev/socket/linuxapk
# (root:audio 0750, see ns-init.sh), and the bridge only accepts Android
# root, system and audioserver (SO_PEERCRED, as host ids). docs/bridge.md.
start_bridge() {
  local bridge=$repo/target/release/linuxapk-bridge base
  [[ -x $bridge ]] || return 0
  read -r base _ < <(awk -F: -v u="$(id -un)" -v n="$(id -u)" '$1==u || $1==n {print $2, $3; exit}' /etc/subuid)
  mkdir -p "$run/bridge"
  # AID_SYSTEM 1000 and AID_AUDIOSERVER 1041 map to base + id - 1.
  local args=(--socket "$run/bridge/bridge.sock" --allow-uid "$(id -u)" --allow-uid $((base + 999))
  --allow-uid $((base + 1040)) ${LINUXAPK_AUDIO_SINK:+--sink "$LINUXAPK_AUDIO_SINK"})
  while :; do
    # The display service connects to the host compositor (windows, input).
    WAYLAND_DISPLAY=${LINUXAPK_WAYLAND:-} "$bridge" "${args[@]}" </dev/null >>"$run/bridge.log" 2>&1
    echo "linuxapk-session: bridge exited ($?); restarting" >>"$run/bridge.log"
    sleep 1
  done &
  for _ in $(seq 50); do
    [[ -S $run/bridge/bridge.sock ]] && return 0
    sleep 0.02
  done
  echo "linuxapk-session: the bridge did not start (see $run/bridge.log)" >&2
}

# Body of the systemd service (internal).
_run() {
  out=$1 data=$2 run=$out/run$sfx
  # Reader holds the FIFO open read-write so writers never block or see EOF.
  cat 0<>"$run/kmsg" >>"$run/kmsg.log" &
  start_bridge
  # Outer namespaces: user (subuid map), mount, pid, cgroup. pivot-exec then
  # nests user/mount/pid/cgroup/net/ipc/uts namespaces for Android itself.
  # shellcheck disable=SC2046
  env LINUXAPK_REPO="$repo" LINUXAPK_OUT="$out" LINUXAPK_RUN="$run" LINUXAPK_DATA="$data" \
    LINUXAPK_IMG="$img" LINUXAPK_APEX="$apexdir" LINUXAPK_KIND_OVERLAY="$kind_ovl" \
    unshare $(idmaps users) $(idmaps groups) --mount --pid --cgroup --fork --kill-child \
    -- "$here/ns-init.sh" </dev/null >"$run/session.out" 2>&1 &
  local ushare=$! outer="" inner=""
  for _ in $(seq 200); do
    [[ -z $outer ]] && outer=$(pgrep -P "$ushare" | head -1 || true)
    [[ -n $outer ]] && inner=$(pgrep -P "$outer" -x 'init|sh' | head -1 || true)
    [[ -n $inner ]] && break
    kill -0 "$ushare" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -n $inner ]]; then
    echo "$outer" >"$run/outer.pid"
    echo "$inner" >"$run/pid"
    # User-mode networking for the session's own network namespace. No
    # inbound port forwarding, and --no-map-gw keeps the host's loopback
    # services unreachable from Android. The interface is eth1 so Android's
    # EthernetService brings it up (DHCP from pasta) as the default network;
    # the emulator's resources pin eth0 as a restricted network. DHCP hands
    # out 169.254.1.1 as the resolver, which pasta forwards to the host's
    # first IPv4 nameserver (with -D, pasta no longer picks it by itself).
    local dns_host
    dns_host=$(awk '$1 == "nameserver" && $2 !~ /:/ {print $2; exit}' /etc/resolv.conf 2>/dev/null || true)
    pasta --config-net --quiet --foreground --no-netns-quit --no-map-gw -I eth1 \
      -D 169.254.1.1 --dhcp-dns --dns-forward 169.254.1.1 ${dns_host:+--dns-host "$dns_host"} \
      -t none -u none -T none -U none \
      --userns "/proc/$inner/ns/user" --netns "/proc/$inner/ns/net" >>"$run/session.out" 2>&1 &
    echo $! >"$run/pasta.pid"
  fi
  wait "$ushare"
  [[ -f $run/pasta.pid ]] && kill "$(<"$run/pasta.pid")" 2>/dev/null
  return 0
}

stop() {
  local p
  for f in outer.pid pid; do
    [[ -f $run/$f ]] && p=$(<"$run/$f") && [[ -d /proc/$p ]] && kill -KILL "$p" 2>/dev/null
  done
  systemctl --user stop "$unit" 2>/dev/null || true
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  for _ in $(seq 50); do
    [[ $(systemctl --user show -P LoadState "$unit" 2>/dev/null) == not-found ]] && break
    sleep 0.1
  done
  rm -f "$run/pid" "$run/outer.pid"
  echo "session stopped"
}

status() {
  if p=$(ns_pid); then echo "running: host pid $p"; else
    echo "stopped"
    return 1
  fi
}

# Run a command inside the session (root in the user ns), with the Android
# environment from init.environ.rc and the derived classpath.
exec_in() {
  local p
  p=$(ns_pid) || die "not running"
  # Join the session's own cgroup so nothing started here outlives "stop".
  local cg
  cg=$(systemctl --user show -P ControlGroup "$unit")
  [[ -n $cg ]] && echo $$ >"/sys/fs/cgroup$cg/cgroup.procs"
  # shellcheck disable=SC2016 # expanded by the session's shell
  exec nsenter -t "$p" -U -m -p -C -n -i -u --preserve-credentials -r -w \
    /system/bin/sh -c '
      for f in /init.environ.rc /data/system/environ/classpath; do
        [ -r "$f" ] && eval "$(sed -n "s/^ *export \([^ ]*\) \(.*\)/export \1=\"\2\"/p" "$f")"
      done
      export PATH=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin
      export HOME=/data/local/tmp TMPDIR=/data/local/tmp
      cd /
      exec "$@"' sh "$@"
}

# Host-safety probes against a live session; each must report "ok".
selftest() {
  local p
  p=$(ns_pid) || die "not running"
  {
    [[ $(readlink "/proc/$p/ns/net") != $(readlink /proc/self/ns/net) ]] &&
      echo "ok   own network namespace" || echo "FAIL shares the host network namespace"
    [[ $(readlink "/proc/$p/ns/ipc") != $(readlink /proc/self/ns/ipc) ]] &&
      echo "ok   own IPC namespace" || echo "FAIL shares the host IPC namespace"
    grep -q "/$unit.service" "/proc/$p/cgroup" &&
      echo "ok   runs in $unit.service's cgroup" || echo "FAIL cgroup: $(cat "/proc/$p/cgroup")"
    grep -Eq '^Groups:[[:space:]]*$' "/proc/$p/status" &&
      echo "ok   no host supplementary groups" || echo "FAIL $(grep ^Groups "/proc/$p/status")"
    # shellcheck disable=SC2016 # expanded by the session's shell
    "$0" exec /system/bin/sh -c '
      t() { if eval "$2" >/dev/null 2>&1; then echo "FAIL $1"; else echo "ok   $1"; fi; }
      t "umount of the fusectl mask refused" "umount /sys/fs/fuse/connections"
      t "lazy umount of a /sys mask refused" "umount -l /sys/firmware/efi/efivars"
      t "remount /sys rw refused" "mount -o remount,bind,rw /sys"
      t "sysfs not writable" "echo 1 > /sys/kernel/mm/ksm/run"
      t "no FUSE connections visible" "[ -n \"\$(ls -A /sys/fs/fuse/connections)\" ]"
      t "fresh sysfs mount refused" "mkdir -p /tmp/.st && mount -t sysfs s /tmp/.st"
      t "sysrq refused" "echo h > /proc/sysrq-trigger"
      t "umount of the staged APEX tree refused" "umount /linuxapk/apex"
    ' 2>&1 | grep -v 'linker'
  } >"$run/selftest.txt"
  cat "$run/selftest.txt"
  ! grep -q FAIL "$run/selftest.txt"
}

case ${1:-} in
  start)
    shift
    start "$@"
    ;;
  stop) stop ;;
  prepare) prepare ;;
  image) printf 'image=%s\nkind=%s\nimg=%s\napex=%s\n' "$image" "$kind" "$img" "$apexdir" ;;
  _run)
    shift
    _run "$@"
    ;;
  status) status ;;
  selftest) selftest ;;
  log)
    shift
    if [[ ${1:-} == -f ]]; then exec tail -n +1 -f "$run/kmsg.log"; else cat "$run/kmsg.log"; fi
    ;;
  exec)
    shift
    (($#)) || die "usage: exec CMD..."
    exec_in "$@"
    ;;
  shell) exec_in /system/bin/sh -l ;;
  *)
    sed -n '2,18s/^# \{0,1\}//p' "$0"
    exit 1
    ;;
esac
