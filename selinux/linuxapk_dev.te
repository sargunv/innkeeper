module linuxapk_dev 1.0;

require {
    type unconfined_t;
    class binder { set_context_mgr call transfer impersonate };
}

# Dev-only: let ordinary user processes (unconfined_t) use binder, including
# becoming the context manager of a private binderfs instance they mounted.
allow unconfined_t self:binder { set_context_mgr call transfer impersonate };
