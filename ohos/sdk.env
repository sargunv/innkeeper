# The OpenHarmony SDK that builds the probe HAP (ohos/probe), and the rollup
# that runs the SDK's ArkTS compiler. ohos/sdk.sh fetches both. The SDK archive
# holds one zip per component, and the build uses the first two, toolchains
# and ets. sdk.sh stops reading the archive after them, so a fetch downloads
# about 180 MB of its 3.7 GB. The SDK matches the image's OpenHarmony 7.0 and
# API 26. The file must hold plain KEY=VALUE lines.
OHOS_SDK_URL=https://repo.huaweicloud.com/openharmony/os/7.0-Release/ohos-sdk-windows_linux-public_20260829.tar.gz
OHOS_SDK_VERSION=26.0.0.38
OHOS_SDK_API=26
OHOS_SDK_TOOLCHAINS_SHA256=50b8c27dbba4d9ee34840613b08f988cd164e30d46dadaa149883b6f14fd83b7
OHOS_SDK_ETS_SHA256=3b8418f9e931e47699dd1f8bf9bf31ad13691748e45be202d33977e430ceb0d1
ROLLUP_URL=https://registry.npmjs.org/rollup/-/rollup-3.29.5.tgz
ROLLUP_SHA256=0ab853d5ad72703fd2d5500705e1d64beac9dcc1885424f9ca85d48cd09076bf
