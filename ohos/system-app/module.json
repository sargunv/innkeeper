{
  "app": {
    "bundleName": "dev.sargunv.innkeeper.system",
    "vendor": "innkeeper",
    "versionCode": 1,
    "versionName": "1",
    "icon": "$media:icon",
    "label": "$string:app_name",
    "apiReleaseType": "Release",
    "compileSdkType": "OpenHarmony",
    "minAPIVersion": 26,
    "targetAPIVersion": 26,
    "bundleType": "app",
    "generateBuildHash": true
  },
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:service_description",
    "mainElement": "SystemService",
    "deviceTypes": ["default", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "virtualMachine": "ark",
    "compileMode": "esmodule",
    "requestPermissions": [
      { "name": "ohos.permission.GET_BACKGROUND_TASK_INFO" },
      { "name": "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED" },
      { "name": "ohos.permission.GET_BUNDLE_RESOURCES" },
      { "name": "ohos.permission.LISTEN_BUNDLE_CHANGE" },
      { "name": "ohos.permission.READ_ACCESSIBILITY_CONFIG" },
      { "name": "ohos.permission.SET_TIME_ZONE" },
      { "name": "ohos.permission.UPDATE_CONFIGURATION" },
      { "name": "ohos.permission.WRITE_ACCESSIBILITY_CONFIG" }
    ],
    "extensionAbilities": [
      {
        "name": "SystemService",
        "srcEntry": "./ets/service/SystemService.ets",
        "type": "service",
        "description": "$string:service_description",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "exported": false
      },
      {
        "name": "HostIme",
        "srcEntry": "./ets/ime/HostIme.ets",
        "type": "inputMethod",
        "description": "$string:ime_description",
        "icon": "$media:icon",
        "label": "$string:ime_name",
        "exported": true
      }
    ]
  }
}
