{
  "app": {
    "bundleName": "dev.sargunv.innkeeper.user",
    "vendor": "innkeeper",
    "versionCode": 1,
    "versionName": "1",
    "icon": "$media:icon",
    "label": "$string:app_name",
    "apiReleaseType": "Release",
    "compileSdkType": "OpenHarmony",
    "minAPIVersion": 26,
    "targetAPIVersion": 26,
    "bundleType": "app",
    "generateBuildHash": true
  },
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:service_description",
    "mainElement": "UserService",
    "deviceTypes": ["default", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "virtualMachine": "ark",
    "compileMode": "esmodule",
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED"
      },
      {
        "name": "ohos.permission.GET_BUNDLE_RESOURCES"
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD"
      },
      {
        "name": "ohos.permission.START_ABILITIES_FROM_BACKGROUND"
      },
      {
        "name": "ohos.permission.GET_DEFAULT_APPLICATION"
      },
      {
        "name": "ohos.permission.SET_DEFAULT_APPLICATION"
      },
      {
        "name": "ohos.permission.START_INVISIBLE_ABILITY"
      }
    ],
    "extensionAbilities": [
      {
        "name": "UserService",
        "srcEntry": "./ets/service/UserService.ets",
        "type": "service",
        "description": "$string:service_description",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "exported": false
      },
      {
        "name": "AppSelectorExtensionAbility",
        "srcEntry": "./ets/selector/AppSelectorExtensionAbility.ets",
        "type": "sys/commonUI",
        "description": "$string:selector_description",
        "icon": "$media:icon",
        "label": "$string:chooser_label",
        "exported": true
      }
    ],
    "abilities": [
      {
        "name": "ChooserAbility",
        "srcEntry": "./ets/chooser/ChooserAbility.ets",
        "description": "$string:chooser_description",
        "icon": "$media:icon",
        "label": "$string:chooser_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "excludeFromMissions": true,
        "removeMissionAfterTerminate": true
      },
      {
        "name": "DesktopAbility",
        "srcEntry": "./ets/desktop/DesktopAbility.ets",
        "description": "$string:desktop_description",
        "icon": "$media:icon",
        "label": "$string:desktop_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "excludeFromMissions": true,
        "removeMissionAfterTerminate": true,
        "skills": [
          {
            "actions": ["ohos.want.action.viewData"],
            "entities": ["entity.system.browsable"],
            "uris": [
              {
                "scheme": "http"
              },
              {
                "scheme": "https"
              },
              {
                "scheme": "mailto"
              },
              {
                "scheme": "tel"
              },
              {
                "scheme": "sms"
              },
              {
                "scheme": "smsto"
              },
              {
                "scheme": "geo"
              },
              {
                "scheme": "market"
              },
              {
                "scheme": "magnet"
              },
              {
                "scheme": "webcal"
              },
              {
                "scheme": "webcals"
              },
              {
                "scheme": "ftp"
              },
              {
                "scheme": "ftps"
              }
            ]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              {
                "scheme": "file",
                "type": "*/*"
              }
            ]
          }
        ]
      }
    ]
  }
}
