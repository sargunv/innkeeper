# What the system app's build adds to the SDK that ohos/sdk.env pins.
# ohos/system-app/sdk.sh fetches them. The file must hold plain KEY=VALUE
# lines.
#
# The SDK's ets/api leaves out the system APIs. interface_sdk-js at the
# release's tag holds the full declarations in api/, and two scripts in its
# build-tools make the SDK's files from them. The checksum is of `sha256sum`
# over those files in sorted order.
OHOS_INTERFACE_URL=https://gitcode.com/openharmony/interface_sdk-js.git
OHOS_INTERFACE_COMMIT=9fc83cbc8a26528f219c74ccb44b42cc4aff379f
OHOS_INTERFACE_SHA256=cbb18bac54585f292df20eec5b392a634df4cb5e356fe4e801c26c9f7c7d9285
# OpenHarmony's N-API follows Node's C ABI, so the native module builds with
# Node's headers (MIT).
NODE_API_HEADERS_URL=https://registry.npmjs.org/node-api-headers/-/node-api-headers-1.9.0.tgz
NODE_API_HEADERS_SHA256=6cbfac49542194ae2c8f1dee5fa2dc00d66bec9cbf3b59e3a4e5f16d14eb0d19
