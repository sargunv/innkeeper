# Extra androidboot.* values for the AOSP CI cuttlefish image (ci-<build>);
# linuxapk-session adds them to the bootconfig, so they become ro.boot.*.
#
# Vendor APEX selection, the mechanism cuttlefish's launcher uses: apexd
# activates only the file named by ro.boot.vendor.apex.<apex name>, and "none"
# drops the APEX (its services, VINTF fragments and feature files with it).
# tools/flatten-apex.sh applies the same rule. See docs/image.md.

# Software HALs (what launch_cvd selects for a guest without a TEE).
androidboot.vendor.apex.com.android.hardware.keymint=com.android.hardware.keymint.rust_nonsecure
androidboot.vendor.apex.com.android.hardware.gatekeeper=com.android.hardware.gatekeeper.nonsecure

# Graphics: our allocator, mapper, composer3 and RADV/lavapipe
# (out/vendor-overlay) replace minigbm, the image's composers and gfxstream.
androidboot.vendor.apex.com.android.hardware.graphics.composer=none
androidboot.vendor.apex.com.google.cf.gralloc=none
androidboot.vendor.apex.com.google.cf.vulkan=none

# Devices that only exist in the cuttlefish VM (virtio consoles, vsock to the
# host's cuttlefish services, the modem simulator, virtual Wi-Fi/BT/NFC).
androidboot.vendor.apex.com.google.cf.bt=none
androidboot.vendor.apex.com.google.cf.rild=none
androidboot.vendor.apex.com.google.cf.wifi=none
androidboot.vendor.apex.com.google.cf.wpa_supplicant=none
androidboot.vendor.apex.com.android.hardware.wifi=none
androidboot.vendor.apex.com.google.cf.nfc=none
androidboot.vendor.apex.com.google.cf.oemlock=none
androidboot.vendor.apex.com.google.cf.identity=none
androidboot.vendor.apex.com.google.cf.confirmationui=none
androidboot.vendor.apex.com.google.emulated.camera.provider.hal=none
androidboot.vendor.apex.com.android.hardware.gnss=none
androidboot.vendor.apex.com.android.hardware.uwb=none
androidboot.vendor.apex.com.android.hardware.usb=none
androidboot.vendor.apex.com.android.hardware.boot=none
# Lights talk to the cuttlefish host over vsock (the service panics without it).
androidboot.vendor.apex.com.google.cf.light=none
# Empty demo APEX; the image's own /vendor/bin/init_dev_config also disables it
# (ro.vendor.init_dev_config.path). apexd and flatten-apex.sh must agree.
androidboot.vendor.apex.com.google.cf.disabled=none
# Thread radio HAL: expects a cuttlefish instance node id (aborts with 0).
androidboot.vendor.apex.com.android.hardware.threadnetwork=none
