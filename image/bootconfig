# Extra androidboot.* values for the AOSP CI cuttlefish image (ci-<build>).
# innkeeper-session adds them to the bootconfig, where they become ro.boot.*
# properties.
#
# These values select vendor APEXes the way cuttlefish's launcher does. apexd
# activates only the file named by ro.boot.vendor.apex.<apex name>, and "none"
# drops the APEX along with its services, VINTF fragments and feature files.
# image/flatten-apex.sh applies the same rule. See image/README.md.

# Software HALs, which launch_cvd selects for a guest without a TEE.
androidboot.vendor.apex.com.android.hardware.keymint=com.android.hardware.keymint.rust_nonsecure
androidboot.vendor.apex.com.android.hardware.gatekeeper=com.android.hardware.gatekeeper.nonsecure

# Our allocator, mapper, composer3 and RADV/lavapipe
# (android/vendor/{graphics,vulkan}) replace minigbm, the image's composers and
# gfxstream.
androidboot.vendor.apex.com.android.hardware.graphics.composer=none
androidboot.vendor.apex.com.google.cf.gralloc=none
androidboot.vendor.apex.com.google.cf.vulkan=none

# Our health HAL (android/vendor/health) reports the host's battery.
# Cuttlefish's fakes a charging one.
androidboot.vendor.apex.com.google.cf.health=none

# Devices that only exist in the cuttlefish VM (virtio consoles, vsock to the
# host's cuttlefish services, the modem simulator, virtual Wi-Fi/BT/NFC).
androidboot.vendor.apex.com.google.cf.bt=none
androidboot.vendor.apex.com.google.cf.rild=none
androidboot.vendor.apex.com.google.cf.wifi=none
androidboot.vendor.apex.com.google.cf.wpa_supplicant=none
androidboot.vendor.apex.com.android.hardware.wifi=none
androidboot.vendor.apex.com.google.cf.nfc=none
androidboot.vendor.apex.com.google.cf.oemlock=none
androidboot.vendor.apex.com.google.cf.identity=none
androidboot.vendor.apex.com.google.cf.confirmationui=none
androidboot.vendor.apex.com.google.emulated.camera.provider.hal=none
androidboot.vendor.apex.com.android.hardware.gnss=none
androidboot.vendor.apex.com.android.hardware.uwb=none
androidboot.vendor.apex.com.android.hardware.usb=none
androidboot.vendor.apex.com.android.hardware.boot=none
# The lights HAL talks to the cuttlefish host over vsock and panics without it.
androidboot.vendor.apex.com.google.cf.light=none
# An empty demo APEX. The image's /vendor/bin/init_dev_config also disables it
# (ro.vendor.init_dev_config.path). apexd and flatten-apex.sh must agree.
androidboot.vendor.apex.com.google.cf.disabled=none
# The Thread radio HAL expects a cuttlefish instance node id and aborts with 0.
androidboot.vendor.apex.com.android.hardware.threadnetwork=none

# Example HALs for hardware that a desktop session doesn't have. Each one is a
# resident process that serves nothing (#28), and their clients cope with an
# absent HAL.
# NNAPI's sample drivers are three processes. NNAPI runs on its CPU path
# without them.
androidboot.vendor.apex.com.android.hardware.neuralnetworks=none
androidboot.vendor.apex.com.android.hardware.contexthub=none
androidboot.vendor.apex.com.android.hardware.ir=none
androidboot.vendor.apex.com.android.hardware.vibrator=none
androidboot.vendor.apex.com.android.hardware.cas=none
androidboot.vendor.apex.com.android.hardware.tetheroffload=none
androidboot.vendor.apex.com.android.hardware.net.nlinterceptor=none
androidboot.vendor.apex.com.android.hardware.rebootescrow=none
androidboot.vendor.apex.com.android.hardware.authsecret=none
androidboot.vendor.apex.com.android.hardware.input.processor=none
