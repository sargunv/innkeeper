#!/system/bin/sh
# Android shares the host's network. Accept netd's firewall commands without
# changing it; restore stays alive and echoes its #PING acknowledgements.
case ${0##*/} in
  *-restore)
    while IFS= read -r line; do
      case $line in '#'*) echo "$line" ;; esac
    done
    ;;
esac
exit 0
