#!/system/bin/sh
# Android shares the host's network, so this accepts netd's firewall commands
# without applying them. The -restore variants keep running and echo netd's
# #PING lines back as acknowledgements.
case ${0##*/} in
  *-restore)
    while IFS= read -r line; do
      case $line in '#'*) echo "$line" ;; esac
    done
    ;;
esac
exit 0
