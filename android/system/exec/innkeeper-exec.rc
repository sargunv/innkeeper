# innkeeper: binder is served through the seccomp filter on init, which
# `innkeeper-session exec` processes don't inherit. This relay is an init
# descendant, so it runs their commands for them
# (android/system/exec/innkeeper-exec.c).
service innkeeper-execd /system/bin/innkeeper-exec --serve
    class core
    user root
    group root
    disabled

on post-fs-data
    start innkeeper-execd
