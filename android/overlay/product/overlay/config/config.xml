<?xml version="1.0" encoding="utf-8"?>
<!--
  Innkeeper: default to gesture navigation. On our 1280x800 display Launcher3
  shows the taskbar, and with three-button navigation (the framework default)
  its bubble bar calls TaskbarNavButtonController before init: an NPE on
  cueBarController that crash-loops the launcher whenever it is in front.
  Still mutable, so the user can switch back in Settings.
-->
<config>
  <overlay package="com.android.internal.systemui.navbar.gestural" enabled="true" />
</config>
