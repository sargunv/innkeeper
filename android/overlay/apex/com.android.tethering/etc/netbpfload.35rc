# innkeeper: replaces the APEX's netbpfload.35rc. The real netbpfload runs, and
# the session's userspace emulator (supervisor/broker/src/bpf.rs) serves its
# bpf() calls. Maps are created and pinned under /sys/fs/bpf, and program loads
# and attaches succeed without effect. innkeeper-bpfload gives netbpfload a
# private mount namespace with writable stand-ins for the BPF sysctls it sets,
# which are absent or read-only in a user namespace. A failure doesn't reboot
# the session.
service bpfloader /system/bin/innkeeper-bpfload
    disabled
    namespace mnt
    group root graphics network_stack net_admin net_bw_acct net_bw_stats net_raw system
    user root
    file /dev/kmsg w
    oneshot
    override
