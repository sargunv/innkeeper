# innkeeper: the image's lmkd service (system/etc/init/lmkd.rc), plus the shim.
# In Flatpak mode lmkd's 1 s PSI windows need a capability the sandbox lacks;
# the shim widens them to 2 s (INNKEEPER_PSI_WINDOW). No effect otherwise.
# Map oom_score_adj into the unprivileged range, so foreground promotion can
# lower a cached app's kernel score again (INNKEEPER_OOM_ADJ).
service lmkd /system/bin/lmkd
    class core
    user lmkd
    group lmkd system readproc
    capabilities DAC_OVERRIDE KILL IPC_LOCK SYS_NICE SYS_RESOURCE
    critical
    socket lmkd seqpacket+passcred 0660 system system
    task_profiles ServiceCapacityLow
    setenv LD_PRELOAD /system/lib64/libinnkeeper_shim.so
    setenv INNKEEPER_PSI_WINDOW 1
    setenv INNKEEPER_OOM_ADJ 1
    override
