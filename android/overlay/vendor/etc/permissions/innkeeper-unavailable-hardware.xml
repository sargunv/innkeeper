<?xml version="1.0" encoding="utf-8"?>
<!-- Innkeeper: the image's handheld_core_hardware.xml declares hardware that the
     session doesn't have. image/bootconfig disables cf.bt, and without a
     Bluetooth HAL com.android.bluetooth aborts in a loop
     (HidlHci: hci_ == nullptr) whenever the feature is present. -->
<permissions>
    <unavailable-feature name="android.hardware.bluetooth" />
    <unavailable-feature name="android.hardware.bluetooth_le" />
</permissions>
