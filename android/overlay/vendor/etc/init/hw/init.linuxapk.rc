# Device rc for androidboot.hardware=linuxapk (imported by init.rc as
# /vendor/etc/init/hw/init.${ro.hardware}.rc). Replaces the image's
# init.cutf_cvm.rc (blanked in this overlay). androidboot.* values from
# linuxapk-session can override.

on early-init
    # ro.hardware.egl/vulkan and ro.opengles.version come from
    # /vendor/build.prop (generated by linuxapk-session from gpu.prop).
    setprop debug.sf.nobootanimation 1
    setprop ro.config.low_ram false
    # Codec2 linear buffers: default to BLOB (gralloc, our udmabuf allocator)
    # instead of ION/dma-buf heaps, which the session can't open. Without it
    # every MediaCodec fails to start with NO_MEMORY ("cannot allocate memory
    # at all"), so SoundPool loads no sounds and media won't play.
    # Mask = ION | BUFFERQUEUE (the default) | BLOB.
    setprop debug.stagefright.c2-poolmask 851968

on late-fs
    # There is no fstab: /data and /metadata are already mounted by the
    # session launcher (a host directory and a tmpfs). mount_all would set
    # ro.crypto.state and queue "nonencrypted", which starts class main and
    # late_start; do that here.
    setprop ro.crypto.state unsupported
    trigger nonencrypted

# The default 256 KiB log buffers wrap within seconds of boot, so enlarge them
# as soon as logd is up, without holding up the remaining init actions.
on property:logd.ready=true
    exec_background - root root -- /system/bin/logcat -G 16M

on property:sys.boot_completed=1
    # Commit the launcher's candidate only after the framework finishes booting.
    exec_background - root root -- /system/bin/sh -c "cp /linuxapk/data-version-booted /data/.linuxapk-data-version.tmp && mv /data/.linuxapk-data-version.tmp /data/.linuxapk-data-version"
    # SystemUI's "Viewing full screen" cling takes focus from every immersive
    # app (games) until dismissed. On a desktop it has no purpose, so mark it
    # as already confirmed.
    # (As root: "cmd settings" from uid system hits an NPE resolving the caller.)
    exec_background - root root -- /system/bin/settings put secure immersive_mode_confirmations confirmed
    # Desktop defaults, once per /data (see the script).
    exec_background - root root -- /system/bin/linuxapk-first-boot
    # Keep few idle processes, as a desktop does. The framework leaves trimming
    # to lmkd (1024 cached processes allowed), and lmkd only acts on memory
    # pressure, which the session's cgroup rarely sees: every process the
    # session ever started stayed. 16 cached processes, at most 8 of them
    # empty (no activity, service or provider). Apply the limit immediately:
    # the post-boot grace period otherwise keeps boot receivers resident until
    # another OOM adjustment happens after it expires, even in an idle session.
    exec_background - root root -- /system/bin/device_config put activity_manager max_cached_processes 16
    exec_background - root root -- /system/bin/device_config put activity_manager no_kill_cached_processes_post_boot_completed_duration_millis 0
