# The device rc for androidboot.hardware=innkeeper. init.rc imports it as
# /vendor/etc/init/hw/init.${ro.hardware}.rc. It replaces the image's
# init.cutf_cvm.rc, which this overlay blanks. androidboot.* values from
# innkeeper-session can override these settings.

on early-init
    # ro.hardware.egl, ro.hardware.vulkan and ro.opengles.version come from
    # /vendor/build.prop, which innkeeper-session extends with
    # android/vendor/vulkan/etc/vulkan.prop.
    setprop debug.sf.nobootanimation 1
    setprop ro.config.low_ram false
    # Codec2 allocates linear buffers from BLOB, which is gralloc backed by our
    # udmabuf allocator, because the session can't open ION or dma-buf heaps.
    # Without this every MediaCodec fails to start with NO_MEMORY ("cannot
    # allocate memory at all"), so SoundPool loads no sounds and media won't
    # play. The mask is ION | BUFFERQUEUE, the default, plus BLOB.
    setprop debug.stagefright.c2-poolmask 851968

on late-fs
    # There is no fstab. The session launcher mounts /data from a host
    # directory and /metadata as a tmpfs. mount_all would set ro.crypto.state
    # and queue "nonencrypted", which starts class main and late_start, so
    # this action does both.
    setprop ro.crypto.state unsupported
    trigger nonencrypted

# The default 256 KiB log buffers wrap within seconds of boot, so enlarge them
# as soon as logd is up, without holding up the remaining init actions.
on property:logd.ready=true
    exec_background - root root -- /system/bin/logcat -G 16M

on property:sys.boot_completed=1
    # Commit the launcher's candidate data version only after the framework
    # finishes booting.
    exec_background - root root -- /system/bin/sh -c "cp /innkeeper/data-version-booted /data/.innkeeper-data-version.tmp && mv /data/.innkeeper-data-version.tmp /data/.innkeeper-data-version"
    # SystemUI's "Viewing full screen" cling takes focus from immersive apps,
    # such as games, until the user dismisses it. It serves no purpose on a
    # desktop, so mark it as already confirmed. This runs as root because
    # "cmd settings" from uid system hits an NPE resolving the caller.
    exec_background - root root -- /system/bin/settings put secure immersive_mode_confirmations confirmed
    # Keep few idle processes, as a desktop does. The framework allows 1024
    # cached processes and leaves trimming to lmkd, which acts only on memory
    # pressure. The session rarely sees memory pressure, so every process it
    # started would stay. The limit allows 16 cached processes, at most 8 of
    # them empty (without an activity, service or provider). A zero post-boot
    # grace period applies the limit at once. Otherwise boot receivers stay
    # resident until the next OOM adjustment after the grace period expires,
    # even in an idle session.
    exec_background - root root -- /system/bin/device_config put activity_manager max_cached_processes 16
    exec_background - root root -- /system/bin/device_config put activity_manager no_kill_cached_processes_post_boot_completed_duration_millis 0

# adbd runs for a profile with adb on. innkeeper-session sets
# vendor.innkeeper.adb and service.adb.listen_addrs, a loopback port, from the
# profile's settings, and the CLI and manager change them live. With
# ro.adb.secure=1, adbd accepts only keys in /data/misc/adb/adb_keys.
# init.usb.rc does not start adbd.
on property:vendor.innkeeper.adb=1
    start adbd

on property:vendor.innkeeper.adb=0
    stop adbd

# innkeeper-session sets vendor.innkeeper.nav from the profile's mode. A
# phone-sized phone-mode window gets three navigation buttons, which a mouse
# can click, and everything else gets gestures. The overlay choice persists in
# /data, so each boot sets it again.
on property:sys.boot_completed=1 && property:vendor.innkeeper.nav=threebutton
    exec_background - root root -- /system/bin/cmd overlay enable-exclusive --category com.android.internal.systemui.navbar.threebutton

on property:sys.boot_completed=1 && property:vendor.innkeeper.nav=gestural
    exec_background - root root -- /system/bin/cmd overlay enable-exclusive --category com.android.internal.systemui.navbar.gestural

# On display 0 the framework warns at every boot that the build is
# inconsistent, because VINTF finds no kernel SELinux policy in the session.
# Phone mode shows display 0, so close the dialog once it is up. Windowed
# profiles never show display 0.
on property:sys.boot_completed=1 && property:vendor.innkeeper.mode=phone
    exec_background - root root -- /system/bin/sh -c "sleep 2; am broadcast -a android.intent.action.CLOSE_SYSTEM_DIALOGS"
