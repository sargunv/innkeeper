service vold /system/bin/vold \
        --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 \
        --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class core
    ioprio be 2
    task_profiles ProcessCapacityHigh
    shutdown critical
    group root reserved_disk
    user root
    # linuxapk: labels the directories it creates (setfscreatecon), which
    # fails against the host SELinux without the shim.
    setenv LD_PRELOAD /system/lib64/liblinuxapk_shim.so
    setenv LINUXAPK_EMULATED_STORAGE 1
    reboot_on_failure reboot,vold-failed
