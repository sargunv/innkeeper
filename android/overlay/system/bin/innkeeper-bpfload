#!/system/bin/sh
# Wraps netbpfload in an Innkeeper session (see the tethering APEX's
# netbpfload.35rc override). It runs in its own mount namespace. netbpfload
# writes /proc/sys/kernel/unprivileged_bpf_disabled and
# /proc/sys/net/core/bpf_jit_{enable,kallsyms}. In the session's user and
# network namespaces the first is read-only and the others don't exist, so this
# script gives netbpfload writable stand-ins that only its namespace sees.
d=/dev/.innkeeper-bpfload
mkdir -p $d/core
echo 2 >$d/unprivileged_bpf_disabled
echo 1 >$d/core/bpf_jit_enable
echo 0 >$d/core/bpf_jit_kallsyms
mount --bind $d/unprivileged_bpf_disabled /proc/sys/kernel/unprivileged_bpf_disabled
mount --bind $d/core /proc/sys/net/core
exec /apex/com.android.tethering/bin/netbpfload "$@"
