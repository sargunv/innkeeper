#!/system/bin/sh
# Wraps apexd in an Innkeeper session (see /system/etc/init/apexd.rc). It runs
# in its own mount namespace. apexd rebuilds its database of mounted APEXes
# from /proc/mounts at startup, so this script appends the session launcher's
# entry for each pre-mounted APEX, in the form apexd uses for file-backed erofs
# mounts. The bind mount covers this shell's /proc/$$/mounts, so apexd must
# keep its pid.
cat /proc/self/mounts /innkeeper/apexd-mounts >/dev/.innkeeper-apexd-mounts
mount --bind /dev/.innkeeper-apexd-mounts /proc/$$/mounts
exec /system/bin/apexd "$@"
