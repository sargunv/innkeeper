service vendor.hwcomposer-3-innkeeper /vendor/bin/hw/android.hardware.graphics.composer3-service.innkeeper
    class hal animation
    interface aidl android.hardware.graphics.composer3.IComposer/default
    # Root in the session is the host user, the only uid that the host's
    # /dev/udmabuf lets in through its logind ACL. The windows' buffer pools
    # need udmabuf.
    user root
    group graphics
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow

# Enable HWC-backed virtual displays. SurfaceFlinger hands each virtual
# display's frames to the composer (createVirtualDisplay/setOutputBuffer), so
# the per-app windows of the Innkeeper System app (docs/display.md) can show
# them. This is set before SurfaceFlinger starts, because it reads the property
# once in init().
on early-init
    setprop debug.sf.enable_hwc_vds 1

    # Fit app and SurfaceFlinger work inside a 120 Hz frame instead of queuing
    # whole frames.
    setprop debug.sf.use_phase_offsets_as_durations 1
    setprop debug.sf.late.app.duration 4000000
    setprop debug.sf.late.sf.duration 4000000
    setprop debug.sf.early.app.duration 4000000
    setprop debug.sf.early.sf.duration 4000000
    setprop debug.sf.earlyGl.app.duration 4000000
    setprop debug.sf.earlyGl.sf.duration 4000000
