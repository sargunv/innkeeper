service vendor.hwcomposer-3-linuxapk /vendor/bin/hw/android.hardware.graphics.composer3-service.linuxapk
    class hal animation
    interface aidl android.hardware.graphics.composer3.IComposer/default
    # Root in the session is the host user: the only uid that the host's
    # /dev/udmabuf (a logind ACL) lets in, for the windows' buffer pools.
    user root
    group graphics
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow

# Frame dumps: setprop vendor.linuxapk.hwc.dump.dir /data/vendor/linuxapk/frames
on post-fs-data
    mkdir /data/vendor/linuxapk 0775 system graphics
    mkdir /data/vendor/linuxapk/frames 0775 system graphics

# HWC-backed virtual displays: SurfaceFlinger hands us each virtual display's
# frames (createVirtualDisplay/setOutputBuffer), so the per-app windows of the
# Linux.apk System app (docs/display.md) can show them. Set before
# SurfaceFlinger starts; it reads the property once in init().
on early-init
    setprop debug.sf.enable_hwc_vds 1
