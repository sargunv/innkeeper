diff --git a/src/egl/drivers/dri2/platform_ohos.c b/src/egl/drivers/dri2/platform_ohos.c
new file mode 100644
index 0000000..6714df0
--- /dev/null
+++ b/src/egl/drivers/dri2/platform_ohos.c
@@ -0,0 +1,684 @@
+/*
+ * Copyright © 2026 Innkeeper contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The OpenHarmony platform. Zink draws on the GPU of a DRM render node.
+ * A window surface requests each frame's buffer from the NativeWindow,
+ * imports the buffer's dma-buf, and flushes the buffer back to the window
+ * in eglSwapBuffers, as the Android platform does with an ANativeWindow.
+ * EGL_NATIVE_BUFFER_OHOS images import a NativeWindowBuffer's dma-buf the
+ * same way.
+ *
+ * The surface creation follows platform_ohos.c in OpenHarmony's Mesa,
+ * https://gitee.com/openharmony/third_party_mesa3d at
+ * ea74a6339917390657db153cb9792f9ccac9f5ae.
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <native_buffer/buffer_common.h>
+#include <native_window/external_window.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "dri_util.h"
+#include "egl_dri2.h"
+#include "eglglobals.h"
+#include "loader_dri_helper.h"
+#include "util/format/u_format.h"
+#include "util/libsync.h"
+
+/* From OpenHarmony's EGL headers. */
+#ifndef EGL_NATIVE_BUFFER_OHOS
+#define EGL_NATIVE_BUFFER_OHOS 0x34E1
+#endif
+
+/* The formats of window surfaces and of imported buffers. A window's buffers
+ * have the window's format, and the window configs are those of the formats
+ * that OpenHarmony's windows use.
+ */
+static const struct {
+   int native_format;
+   enum pipe_format pipe_format;
+   uint32_t fourcc;
+   bool window;
+} ohos_formats[] = {
+   {NATIVEBUFFER_PIXEL_FMT_RGBA_8888, PIPE_FORMAT_RGBA8888_UNORM,
+    DRM_FORMAT_ABGR8888, true},
+   {NATIVEBUFFER_PIXEL_FMT_RGBX_8888, PIPE_FORMAT_RGBX8888_UNORM,
+    DRM_FORMAT_XBGR8888, true},
+   {NATIVEBUFFER_PIXEL_FMT_RGB_565, PIPE_FORMAT_B5G6R5_UNORM,
+    DRM_FORMAT_RGB565, true},
+   {NATIVEBUFFER_PIXEL_FMT_RGBA_1010102, PIPE_FORMAT_R10G10B10A2_UNORM,
+    DRM_FORMAT_ABGR2101010, true},
+   {NATIVEBUFFER_PIXEL_FMT_BGRA_8888, PIPE_FORMAT_BGRA8888_UNORM,
+    DRM_FORMAT_ARGB8888, false},
+   {NATIVEBUFFER_PIXEL_FMT_BGRX_8888, PIPE_FORMAT_BGRX8888_UNORM,
+    DRM_FORMAT_XRGB8888, false},
+};
+
+/* The YUV 4:2:0 formats that the buffer VDI allocates. The chroma planes
+ * follow the luma plane in the same dma-buf. A semi-planar format has one
+ * chroma plane with the luma's row pitch. A planar format has two chroma
+ * planes with half that pitch, in the order that the format names them.
+ */
+static const struct {
+   int native_format;
+   uint32_t fourcc;
+   bool planar;
+} ohos_yuv_formats[] = {
+   {NATIVEBUFFER_PIXEL_FMT_YCBCR_420_SP, DRM_FORMAT_NV12, false},
+   {NATIVEBUFFER_PIXEL_FMT_YCRCB_420_SP, DRM_FORMAT_NV21, false},
+   {NATIVEBUFFER_PIXEL_FMT_YCBCR_420_P, DRM_FORMAT_YUV420, true},
+   {NATIVEBUFFER_PIXEL_FMT_YCRCB_420_P, DRM_FORMAT_YVU420, true},
+};
+
+/* Fills in the fourcc and the planes of a buffer, and returns the number of
+ * planes, or 0 for a format that doesn't import.
+ */
+static int
+ohos_buffer_planes(const BufferHandle *handle, uint32_t *fourcc, int *offsets,
+                   int *pitches)
+{
+   const int stride = handle->stride, height = handle->height;
+
+   offsets[0] = 0;
+   pitches[0] = stride;
+   for (unsigned i = 0; i < ARRAY_SIZE(ohos_formats); i++) {
+      if (ohos_formats[i].native_format == handle->format) {
+         *fourcc = ohos_formats[i].fourcc;
+         return 1;
+      }
+   }
+   for (unsigned i = 0; i < ARRAY_SIZE(ohos_yuv_formats); i++) {
+      if (ohos_yuv_formats[i].native_format != handle->format)
+         continue;
+      const int chroma_rows = (height + 1) / 2;
+      const int luma = stride * height;
+      *fourcc = ohos_yuv_formats[i].fourcc;
+      if (!ohos_yuv_formats[i].planar) {
+         offsets[1] = luma;
+         pitches[1] = stride;
+         return luma + stride * chroma_rows <= handle->size ? 2 : 0;
+      }
+      offsets[1] = luma;
+      offsets[2] = luma + stride / 2 * chroma_rows;
+      pitches[1] = pitches[2] = stride / 2;
+      return offsets[2] + stride / 2 * chroma_rows <= handle->size ? 3 : 0;
+   }
+   return 0;
+}
+
+/* A BufferHandle is a single dma-buf with a row pitch. The handle describes
+ * no tiling, so the buffer is linear. YUV buffers have no color metadata, so
+ * they import as BT.601 limited range with centered chroma, as Android's
+ * gralloc fallback does.
+ */
+static struct dri_image *
+ohos_import_handle(struct dri2_egl_display *dri2_dpy,
+                   const BufferHandle *handle)
+{
+   if (!handle || handle->fd < 0 || handle->stride <= 0 || handle->height <= 0)
+      return NULL;
+
+   uint32_t fourcc = 0;
+   int offsets[3], pitches[3];
+   const int planes = ohos_buffer_planes(handle, &fourcc, offsets, pitches);
+   if (!planes)
+      return NULL;
+
+   int fds[3] = {handle->fd, handle->fd, handle->fd};
+   const bool yuv = planes > 1;
+   unsigned error;
+   return dri2_from_dma_bufs(
+      dri2_dpy->dri_screen_render_gpu, handle->width, handle->height, fourcc,
+      DRM_FORMAT_MOD_LINEAR, fds, planes, pitches, offsets,
+      yuv ? __DRI_YUV_COLOR_SPACE_ITU_REC601 : __DRI_YUV_COLOR_SPACE_UNDEFINED,
+      yuv ? __DRI_YUV_NARROW_RANGE : __DRI_YUV_RANGE_UNDEFINED,
+      yuv ? __DRI_YUV_CHROMA_SITING_0_5 : __DRI_YUV_CHROMA_SITING_UNDEFINED,
+      yuv ? __DRI_YUV_CHROMA_SITING_0_5 : __DRI_YUV_CHROMA_SITING_UNDEFINED, 0,
+      &error, NULL);
+}
+
+static void
+ohos_release_color_buffer(struct ohos_color_buffer *cb)
+{
+   if (cb->image)
+      dri2_destroy_image(cb->image);
+   if (cb->buffer)
+      OH_NativeWindow_NativeObjectUnreference(cb->buffer);
+   memset(cb, 0, sizeof(*cb));
+}
+
+/* Returns the slot for a buffer that the surface hasn't imported yet. The
+ * slots hold at most as many buffers as the window's queue, and the least
+ * recently requested buffers make room. When the queue replaces a buffer,
+ * for example after the window's usage or size changes, the old buffer is
+ * the least recently requested one.
+ */
+static struct ohos_color_buffer *
+ohos_free_slot(struct dri2_egl_surface *dri2_surf)
+{
+   const int slots = ARRAY_SIZE(dri2_surf->ohos_color_buffers);
+   int32_t queue_size = 0;
+
+   OH_NativeWindow_NativeWindowHandleOpt(dri2_surf->ohos_window,
+                                         GET_BUFFERQUEUE_SIZE, &queue_size);
+   const int capacity = CLAMP(queue_size, 1, slots);
+
+   for (;;) {
+      struct ohos_color_buffer *empty = NULL, *oldest = NULL;
+      int used = 0;
+      for (int i = 0; i < slots; i++) {
+         struct ohos_color_buffer *cb = &dri2_surf->ohos_color_buffers[i];
+         if (!cb->buffer) {
+            empty = empty ? empty : cb;
+            continue;
+         }
+         used++;
+         if (!oldest || cb->last_request < oldest->last_request)
+            oldest = cb;
+      }
+      if (used < capacity)
+         return empty;
+      ohos_release_color_buffer(oldest);
+   }
+}
+
+/* Requests the next frame's buffer from the window. The window's usage,
+ * format and size are those that its owner set, so the window's queue can
+ * reuse its buffers.
+ */
+static bool
+ohos_request_buffer(struct dri2_egl_surface *dri2_surf)
+{
+   _EGLDisplay *disp = dri2_surf->base.Resource.Display;
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   OHNativeWindowBuffer *buffer = NULL;
+   int fence_fd = -1;
+
+   if (OH_NativeWindow_NativeWindowRequestBuffer(dri2_surf->ohos_window,
+                                                 &buffer, &fence_fd) != 0 ||
+       !buffer) {
+      _eglLog(_EGL_WARNING, "ohos: the window has no free buffer");
+      return false;
+   }
+
+   const BufferHandle *handle = OH_NativeWindow_GetBufferHandleFromNative(buffer);
+   struct ohos_color_buffer *cb = NULL;
+   for (unsigned i = 0; i < ARRAY_SIZE(dri2_surf->ohos_color_buffers); i++) {
+      if (handle && dri2_surf->ohos_color_buffers[i].handle == handle) {
+         cb = &dri2_surf->ohos_color_buffers[i];
+         break;
+      }
+   }
+   if (!cb) {
+      struct dri_image *image = ohos_import_handle(dri2_dpy, handle);
+      if (!image) {
+         _eglLog(_EGL_WARNING, "ohos: cannot import the window's buffer");
+         if (fence_fd >= 0)
+            close(fence_fd);
+         OH_NativeWindow_NativeWindowAbortBuffer(dri2_surf->ohos_window, buffer);
+         return false;
+      }
+      cb = ohos_free_slot(dri2_surf);
+      OH_NativeWindow_NativeObjectReference(buffer);
+      cb->buffer = buffer;
+      cb->handle = handle;
+      cb->image = image;
+      cb->age = 0;
+   }
+   cb->last_request = ++dri2_surf->ohos_requests;
+
+   /* The fence signals when the window's consumer has released the buffer. */
+   if (fence_fd >= 0) {
+      if (disp->Extensions.ANDROID_native_fence_sync)
+         dri2_set_in_fence_fd(cb->image, fence_fd);
+      else
+         sync_wait(fence_fd, -1);
+      close(fence_fd);
+   }
+
+   dri2_surf->ohos_buffer = buffer;
+   dri2_surf->ohos_back = cb;
+   dri2_surf->base.Width = handle->width;
+   dri2_surf->base.Height = handle->height;
+   return true;
+}
+
+/* Returns a sync file that signals when the frame's rendering is done. The
+ * buffers have no implicit synchronization, so without native fences the
+ * swap waits for the rendering.
+ */
+static int
+ohos_frame_fence(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   _EGLContext *ctx = _eglGetCurrentContext();
+   if (!ctx)
+      return -1;
+
+   struct dri_context *dri_ctx = dri2_egl_context(ctx)->dri_context;
+   struct dri_screen *screen = dri2_dpy->dri_screen_render_gpu;
+   int fence_fd = -1;
+   void *fence;
+
+   if (disp->Extensions.ANDROID_native_fence_sync) {
+      fence = dri_create_fence_fd(dri_ctx, -1);
+      if (fence) {
+         fence_fd = dri_get_fence_fd(screen, fence);
+         dri_destroy_fence(screen, fence);
+      }
+   }
+   if (fence_fd < 0) {
+      fence = dri_create_fence(dri_ctx);
+      if (fence) {
+         dri_client_wait_sync(dri_ctx, fence, __DRI2_FENCE_FLAG_FLUSH_COMMANDS,
+                              UINT64_MAX);
+         dri_destroy_fence(screen, fence);
+      }
+   }
+   return fence_fd;
+}
+
+static _EGLSurface *
+ohos_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
+                    void *native_window, const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   OHNativeWindow *window = native_window;
+   const struct dri_config *config;
+
+   struct dri2_egl_surface *dri2_surf = calloc(1, sizeof(*dri2_surf));
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, "ohos_create_surface");
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, type, conf, attrib_list,
+                          false, native_window))
+      goto cleanup_surface;
+
+   if (type == EGL_WINDOW_BIT) {
+      int32_t format = -1, width = 0, height = 0;
+
+      if (!window ||
+          OH_NativeWindow_NativeWindowHandleOpt(window, GET_FORMAT,
+                                                &format) != 0 ||
+          OH_NativeWindow_NativeWindowHandleOpt(window, GET_BUFFER_GEOMETRY,
+                                                &height, &width) != 0) {
+         _eglError(EGL_BAD_NATIVE_WINDOW, "ohos_create_surface");
+         goto cleanup_surface;
+      }
+
+      if (format != dri2_conf->base.NativeVisualID) {
+         _eglLog(_EGL_DEBUG, "native format 0x%x differs from config 0x%x",
+                 format, dri2_conf->base.NativeVisualID);
+      }
+
+      dri2_surf->base.Width = width;
+      dri2_surf->base.Height = height;
+      dri2_surf->ohos_window = window;
+   }
+
+   config = dri2_get_dri_config(dri2_conf, type, dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH,
+                "Unsupported surfacetype/colorspace configuration");
+      goto cleanup_surface;
+   }
+
+   if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf))
+      goto cleanup_surface;
+
+   if (window)
+      OH_NativeWindow_NativeObjectReference(window);
+
+   return &dri2_surf->base;
+
+cleanup_surface:
+   free(dri2_surf);
+   return NULL;
+}
+
+static _EGLSurface *
+ohos_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                           void *native_window, const EGLint *attrib_list)
+{
+   return ohos_create_surface(disp, EGL_WINDOW_BIT, conf, native_window,
+                              attrib_list);
+}
+
+static _EGLSurface *
+ohos_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                            const EGLint *attrib_list)
+{
+   return ohos_create_surface(disp, EGL_PBUFFER_BIT, conf, NULL, attrib_list);
+}
+
+static EGLBoolean
+ohos_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   driDestroyDrawable(dri2_surf->dri_drawable);
+
+   if (dri2_surf->ohos_buffer)
+      OH_NativeWindow_NativeWindowAbortBuffer(dri2_surf->ohos_window,
+                                              dri2_surf->ohos_buffer);
+   for (unsigned i = 0; i < ARRAY_SIZE(dri2_surf->ohos_color_buffers); i++)
+      ohos_release_color_buffer(&dri2_surf->ohos_color_buffers[i]);
+   if (dri2_surf->ohos_pbuffer_image)
+      dri2_destroy_image(dri2_surf->ohos_pbuffer_image);
+   if (dri2_surf->ohos_window)
+      OH_NativeWindow_NativeObjectUnreference(dri2_surf->ohos_window);
+
+   dri2_fini_surface(surf);
+   free(dri2_surf);
+   return EGL_TRUE;
+}
+
+/* The frame reaches the window's consumer before the swap returns, because
+ * render_service takes its screen's buffer from the window as soon as
+ * eglSwapBuffers returns. EGL's damage rectangles and OpenHarmony's both
+ * have their origin at the bottom left.
+ */
+static EGLBoolean
+ohos_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw,
+                              const EGLint *rects, EGLint n_rects)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(dri2_surf->ohos_color_buffers); i++) {
+      if (dri2_surf->ohos_color_buffers[i].age > 0)
+         dri2_surf->ohos_color_buffers[i].age++;
+   }
+   if (dri2_surf->ohos_back)
+      dri2_surf->ohos_back->age = 1;
+
+   dri2_flush_drawable_for_swapbuffers_flags(disp, draw,
+                                             __DRI2_NOTHROTTLE_SWAPBUFFER);
+
+   /* Without GL commands since the last swap, the driver requested no
+    * buffer.
+    */
+   if (dri2_surf->ohos_buffer) {
+      struct Rect *damage = NULL;
+      Region region = {0};
+      if (n_rects > 0) {
+         damage = calloc(n_rects, sizeof(*damage));
+         for (EGLint i = 0; damage && i < n_rects; i++) {
+            damage[i].x = rects[4 * i];
+            damage[i].y = rects[4 * i + 1];
+            damage[i].w = rects[4 * i + 2];
+            damage[i].h = rects[4 * i + 3];
+         }
+         region.rects = damage;
+         region.rectNumber = damage ? n_rects : 0;
+      }
+      if (OH_NativeWindow_NativeWindowFlushBuffer(
+             dri2_surf->ohos_window, dri2_surf->ohos_buffer,
+             ohos_frame_fence(disp), region) != 0)
+         _eglLog(_EGL_WARNING, "ohos: the window did not take the frame");
+      free(damage);
+      dri2_surf->ohos_buffer = NULL;
+      dri2_surf->ohos_back = NULL;
+   }
+
+   dri_invalidate_drawable(dri2_surf->dri_drawable);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+ohos_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   return ohos_swap_buffers_with_damage(disp, draw, NULL, 0);
+}
+
+static EGLint
+ohos_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   if (surf->Type != EGL_WINDOW_BIT)
+      return 0;
+   if (!dri2_surf->ohos_buffer && !ohos_request_buffer(dri2_surf)) {
+      _eglError(EGL_BAD_ALLOC, "ohos_query_buffer_age");
+      return -1;
+   }
+   return dri2_surf->ohos_back->age;
+}
+
+/* The window's queue paces the frames. The platform records the interval
+ * and doesn't use it.
+ */
+static EGLBoolean
+ohos_swap_interval(_EGLDisplay *disp, _EGLSurface *surf, EGLint interval)
+{
+   surf->SwapInterval = interval;
+   return EGL_TRUE;
+}
+
+static int
+ohos_image_get_buffers(struct dri_drawable *driDrawable, unsigned int format,
+                       uint32_t *stamp, void *loaderPrivate,
+                       uint32_t buffer_mask, struct __DRIimageList *images)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+   struct dri2_egl_display *dri2_dpy =
+      dri2_egl_display(dri2_surf->base.Resource.Display);
+
+   images->image_mask = 0;
+   images->front = NULL;
+   images->back = NULL;
+
+   if (dri2_surf->base.Type == EGL_WINDOW_BIT) {
+      if (!(buffer_mask & __DRI_IMAGE_BUFFER_BACK))
+         return 1;
+      if (!dri2_surf->ohos_buffer && !ohos_request_buffer(dri2_surf))
+         return 0;
+      images->back = dri2_surf->ohos_back->image;
+      images->image_mask |= __DRI_IMAGE_BUFFER_BACK;
+      return 1;
+   }
+
+   /* A pbuffer has a front buffer and no back buffer, as on the Android
+    * platform.
+    */
+   if (buffer_mask & __DRI_IMAGE_BUFFER_FRONT) {
+      if (!dri2_surf->ohos_pbuffer_image) {
+         dri2_surf->ohos_pbuffer_image = dri_create_image(
+            dri2_dpy->dri_screen_render_gpu, dri2_surf->base.Width,
+            dri2_surf->base.Height, format, NULL, 0, 0, NULL);
+         if (!dri2_surf->ohos_pbuffer_image)
+            return 0;
+      }
+      images->front = dri2_surf->ohos_pbuffer_image;
+      images->image_mask |= __DRI_IMAGE_BUFFER_FRONT;
+   }
+   return 1;
+}
+
+static void
+ohos_flush_front_buffer(struct dri_drawable *driDrawable, void *loaderPrivate)
+{
+}
+
+/* The window formats are RGBA, so the configs are RGBA. */
+static unsigned
+ohos_get_capability(void *loaderPrivate, enum dri_loader_cap cap)
+{
+   return cap == DRI_LOADER_CAP_RGBA_ORDERING;
+}
+
+static const __DRIimageLoaderExtension ohos_image_loader_extension = {
+   .base = {__DRI_IMAGE_LOADER, 4},
+   .getBuffers = ohos_image_get_buffers,
+   .flushFrontBuffer = ohos_flush_front_buffer,
+   .getCapability = ohos_get_capability,
+};
+
+static const __DRIextension *ohos_loader_extensions[] = {
+   &ohos_image_loader_extension.base,
+   &image_lookup_extension.base,
+   NULL,
+};
+
+static _EGLImage *
+ohos_create_image_native_buffer(_EGLDisplay *disp,
+                                OHNativeWindowBuffer *buffer)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const BufferHandle *handle =
+      buffer ? OH_NativeWindow_GetBufferHandleFromNative(buffer) : NULL;
+
+   struct dri_image *dri_image = ohos_import_handle(dri2_dpy, handle);
+   if (!dri_image) {
+      _eglError(EGL_BAD_PARAMETER, "eglCreateEGLImageKHR");
+      return NULL;
+   }
+
+   return dri2_create_image_from_dri(disp, dri_image);
+}
+
+static _EGLImage *
+ohos_create_image_khr(_EGLDisplay *disp, _EGLContext *ctx, EGLenum target,
+                      EGLClientBuffer buffer, const EGLint *attr_list)
+{
+   /* render_service passes its context with EGL_NATIVE_BUFFER_OHOS, so the
+    * context is ignored.
+    */
+   if (target == EGL_NATIVE_BUFFER_OHOS)
+      return ohos_create_image_native_buffer(disp, buffer);
+
+   return dri2_create_image_khr(disp, ctx, target, buffer, attr_list);
+}
+
+static const struct dri2_egl_display_vtbl dri2_ohos_display_vtbl = {
+   .create_window_surface = ohos_create_window_surface,
+   .create_pbuffer_surface = ohos_create_pbuffer_surface,
+   .destroy_surface = ohos_destroy_surface,
+   .create_image = ohos_create_image_khr,
+   .swap_interval = ohos_swap_interval,
+   .swap_buffers = ohos_swap_buffers,
+   .swap_buffers_with_damage = ohos_swap_buffers_with_damage,
+   .query_buffer_age = ohos_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+static void
+ohos_add_configs_for_visuals(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   unsigned format_count[ARRAY_SIZE(ohos_formats)] = {0};
+
+   for (unsigned i = 0; i < ARRAY_SIZE(ohos_formats); i++) {
+      if (!ohos_formats[i].window)
+         continue;
+      for (unsigned j = 0; dri2_dpy->driver_configs[j]; j++) {
+         const struct gl_config *gl_config =
+            (const struct gl_config *)dri2_dpy->driver_configs[j];
+
+         /* The sRGB configs match their linear formats. */
+         if (util_format_linear(gl_config->color_format) !=
+             ohos_formats[i].pipe_format)
+            continue;
+
+         const EGLint config_attrs[] = {
+            EGL_NATIVE_VISUAL_ID,   ohos_formats[i].native_format,
+            EGL_NATIVE_VISUAL_TYPE, ohos_formats[i].native_format,
+            EGL_NONE,
+         };
+         if (dri2_add_config(disp, dri2_dpy->driver_configs[j],
+                             EGL_WINDOW_BIT | EGL_PBUFFER_BIT, config_attrs))
+            format_count[i]++;
+      }
+   }
+
+   for (unsigned i = 0; i < ARRAY_SIZE(format_count); i++) {
+      if (ohos_formats[i].window && !format_count[i]) {
+         _eglLog(_EGL_DEBUG, "No DRI config supports native format 0x%x",
+                 ohos_formats[i].native_format);
+      }
+   }
+}
+
+/* OpenHarmony has no API that names a GPU, so the platform uses the first
+ * render node that it can open.
+ */
+static int
+ohos_open_render_node(void)
+{
+   for (int minor = 128; minor < 192; minor++) {
+      char path[32];
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", minor);
+      const int fd = open(path, O_RDWR | O_CLOEXEC);
+      if (fd >= 0)
+         return fd;
+   }
+   return -1;
+}
+
+EGLBoolean
+dri2_initialize_ohos(_EGLDisplay *disp)
+{
+   const char *err;
+   struct dri2_egl_display *dri2_dpy = dri2_display_create(disp);
+   if (!dri2_dpy)
+      return EGL_FALSE;
+
+   dri2_dpy->fd_render_gpu = ohos_open_render_node();
+   if (dri2_dpy->fd_render_gpu < 0) {
+      err = "DRI2: no render node";
+      goto cleanup;
+   }
+   dri2_dpy->fd_display_gpu = dri2_dpy->fd_render_gpu;
+
+   dri2_dpy->driver_name = strdup("zink");
+   if (!dri2_dpy->driver_name) {
+      err = "DRI2: failed to allocate the driver name";
+      goto cleanup;
+   }
+   dri2_dpy->loader_extensions = ohos_loader_extensions;
+
+   if (!dri2_create_screen(disp)) {
+      err = "DRI2: failed to create screen";
+      goto cleanup;
+   }
+
+   if (!dri2_setup_device(disp, false)) {
+      err = "DRI2: failed to setup EGLDevice";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+
+   dri2_dpy->min_swap_interval = 0;
+   dri2_dpy->max_swap_interval = 1;
+
+   ohos_add_configs_for_visuals(disp);
+
+   disp->Extensions.KHR_image = EGL_TRUE;
+   disp->Extensions.EXT_buffer_age = EGL_TRUE;
+   disp->Extensions.EXT_swap_buffers_with_damage = EGL_TRUE;
+
+   /* Fill vtbl last to prevent accidentally calling virtual function during
+    * initialization.
+    */
+   dri2_dpy->vtbl = &dri2_ohos_display_vtbl;
+
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, err);
+}
