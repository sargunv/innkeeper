diff --git a/src/intel/vulkan/anv_ohos.c b/src/intel/vulkan/anv_ohos.c
new file mode 100644
index 0000000..1bd2824
--- /dev/null
+++ b/src/intel/vulkan/anv_ohos.c
@@ -0,0 +1,81 @@
+/*
+ * Copyright © 2026 Innkeeper contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "anv_private.h"
+
+#include "vk_ohos.h"
+
+/* Initializes an image on the buffer of a VkNativeBufferOHOS, which is how
+ * OpenHarmony's swapchain layer makes its swapchain images. The image holds
+ * a reference to the BO that it imports from the buffer's dma-buf, as an
+ * image from gralloc does.
+ */
+VkResult
+anv_image_init_from_ohos_native_buffer(struct anv_device *device,
+                                       struct anv_image *image,
+                                       const VkImageCreateInfo *base_info,
+                                       const VkNativeBufferOHOS *native_buffer)
+{
+   VkImageDrmFormatModifierExplicitCreateInfoEXT mod_info;
+   VkSubresourceLayout layout;
+   VkResult result;
+
+   result = vk_ohos_get_native_buffer_layout(native_buffer, &mod_info,
+                                             &layout);
+   if (result != VK_SUCCESS)
+      return vk_error(device, result);
+
+   VkImageCreateInfo info = *base_info;
+   mod_info.pNext = info.pNext;
+   info.pNext = &mod_info;
+   info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+
+   struct anv_image_create_info anv_info = {
+      .vk_info = &info,
+      .isl_extra_usage_flags = ISL_SURF_USAGE_DISABLE_AUX_BIT,
+      .isl_tiling_flags = ISL_TILING_LINEAR_BIT,
+      .stride = layout.rowPitch,
+   };
+
+   /* The handle keeps its fd. anv_device_import_bo does not take it. */
+   struct anv_bo *bo;
+   result = anv_device_import_bo(device, native_buffer->handle->fd,
+                                 ANV_BO_ALLOC_EXTERNAL,
+                                 0 /* client_address */, &bo);
+   if (result != VK_SUCCESS) {
+      return vk_errorf(device, result,
+                       "failed to import the OHOS native buffer's dma-buf");
+   }
+
+   result = anv_image_init(device, image, &anv_info);
+   if (result != VK_SUCCESS)
+      goto fail_bo;
+
+   VkMemoryRequirements2 mem_reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+   };
+   anv_image_get_memory_requirements(device, image, image->vk.aspects,
+                                     &mem_reqs);
+   if (bo->size < mem_reqs.memoryRequirements.size) {
+      result = vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                         "OHOS native buffer too small for the image: "
+                         "%" PRIu64 "B < %" PRIu64 "B",
+                         bo->size, mem_reqs.memoryRequirements.size);
+      anv_image_finish(image);
+      goto fail_bo;
+   }
+
+   assert(!image->disjoint);
+   assert(image->n_planes == 1);
+   image->bindings[ANV_IMAGE_MEMORY_BINDING_MAIN].address.bo = bo;
+   image->from_gralloc = true;
+
+   return VK_SUCCESS;
+
+fail_bo:
+   anv_device_release_bo(device, bo);
+   return result;
+}
