diff --git a/src/amd/vulkan/radv_ohos.c b/src/amd/vulkan/radv_ohos.c
new file mode 100644
index 0000000..e85e9c1
--- /dev/null
+++ b/src/amd/vulkan/radv_ohos.c
@@ -0,0 +1,131 @@
+/*
+ * Copyright © 2026 Innkeeper contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ohos.h"
+#include "radv_device.h"
+#include "radv_device_memory.h"
+#include "radv_entrypoints.h"
+#include "radv_image.h"
+#include "radv_physical_device.h"
+
+#include "util/os_file.h"
+
+#include "vk_log.h"
+#include "vk_ohos.h"
+
+#include <errno.h>
+#include <unistd.h>
+
+/* Creates an image on the buffer of a VkNativeBufferOHOS, which is how
+ * OpenHarmony's swapchain layer makes its swapchain images. The image owns
+ * the memory that it imports from the buffer's dma-buf.
+ */
+VkResult
+radv_image_from_ohos_native_buffer(VkDevice device_h, const VkImageCreateInfo *base_info,
+                                   const VkNativeBufferOHOS *native_buffer, const VkAllocationCallbacks *alloc,
+                                   VkImage *out_image_h)
+{
+   VK_FROM_HANDLE(radv_device, device, device_h);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   VkImageDrmFormatModifierExplicitCreateInfoEXT mod_info;
+   VkSubresourceLayout layout;
+   VkImage image_h;
+   VkDeviceMemory memory_h;
+   VkResult result;
+
+   result = vk_ohos_get_native_buffer_layout(native_buffer, &mod_info, &layout);
+   if (result != VK_SUCCESS)
+      return vk_error(device, result);
+
+   VkExternalMemoryImageCreateInfo external_info = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = base_info->pNext,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   mod_info.pNext = &external_info;
+   VkImageCreateInfo info = *base_info;
+   info.pNext = &mod_info;
+   info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+
+   result = radv_image_create(device_h, &(struct radv_image_create_info){.vk_info = &info}, alloc, &image_h, false);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The handle keeps its fd. Import a duplicate. */
+   int fd = os_dupfd_cloexec(native_buffer->handle->fd);
+   if (fd < 0) {
+      result = vk_error(device, errno == EMFILE ? VK_ERROR_TOO_MANY_OBJECTS : VK_ERROR_OUT_OF_HOST_MEMORY);
+      goto fail_image;
+   }
+
+   VkMemoryFdPropertiesKHR fd_props = {.sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR};
+   result = radv_GetMemoryFdPropertiesKHR(device_h, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fd_props);
+   if (result != VK_SUCCESS)
+      goto fail_fd;
+
+   VkMemoryRequirements2 reqs2 = {.sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2};
+   radv_GetImageMemoryRequirements2(device_h,
+                                    &(VkImageMemoryRequirementsInfo2){
+                                       .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+                                       .image = image_h,
+                                    },
+                                    &reqs2);
+   const VkMemoryRequirements reqs = reqs2.memoryRequirements;
+   const uint32_t types = fd_props.memoryTypeBits & reqs.memoryTypeBits & ~pdev->memory_types_32bit;
+   if (!types) {
+      result = vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE, "no memory type for the OHOS native buffer");
+      goto fail_fd;
+   }
+
+   const VkMemoryDedicatedAllocateInfo dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = image_h,
+   };
+   const VkImportMemoryFdInfoKHR import_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = &dedicated_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = fd,
+   };
+   result = radv_AllocateMemory(device_h,
+                                &(VkMemoryAllocateInfo){
+                                   .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                   .pNext = &import_info,
+                                   .allocationSize = reqs.size,
+                                   .memoryTypeIndex = ffs(types) - 1,
+                                },
+                                alloc, &memory_h);
+   if (result != VK_SUCCESS)
+      goto fail_fd;
+
+   /* The import has taken the fd. */
+   if (radv_device_memory_from_handle(memory_h)->bo->size < reqs.size) {
+      result = vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE, "OHOS native buffer too small for the image");
+      radv_FreeMemory(device_h, memory_h, alloc);
+      goto fail_image;
+   }
+
+   result = radv_BindImageMemory2(device_h, 1,
+                                  &(VkBindImageMemoryInfo){
+                                     .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+                                     .image = image_h,
+                                     .memory = memory_h,
+                                  });
+   if (result != VK_SUCCESS) {
+      radv_FreeMemory(device_h, memory_h, alloc);
+      goto fail_image;
+   }
+
+   radv_image_from_handle(image_h)->owned_memory = memory_h;
+   *out_image_h = image_h;
+   return VK_SUCCESS;
+
+fail_fd:
+   close(fd);
+fail_image:
+   radv_DestroyImage(device_h, image_h, alloc);
+   return result;
+}
