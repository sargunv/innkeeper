@@ -0,0 +1,37 @@
+/*
+ * Copyright © 2022 Intel Corporation
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef VK_NATIVE_BUFFER_H
+#define VK_NATIVE_BUFFER_H
+
+#include "vulkan/vulkan_core.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct vk_device;
+struct vk_queue;
+
+/* Imports the native fence of an acquired buffer into the semaphore and the
+ * fence. It takes ownership of nativeFenceFd, even when it fails.
+ */
+VkResult vk_native_buffer_acquire_image(struct vk_device *device,
+                                        int nativeFenceFd,
+                                        VkSemaphore semaphore,
+                                        VkFence fence);
+
+/* Returns a native fence that signals once the wait semaphores signal and
+ * the queue's earlier work completes.
+ */
+VkResult vk_native_buffer_signal_release_image(
+   struct vk_queue *queue, uint32_t waitSemaphoreCount,
+   const VkSemaphore *pWaitSemaphores, int *pNativeFenceFd);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* VK_NATIVE_BUFFER_H */
diff --git a/src/vulkan/runtime/vk_ohos.c b/src/vulkan/runtime/vk_ohos.c
new file mode 100644
index 0000000..46223c0
--- /dev/null
+++ b/src/vulkan/runtime/vk_ohos.c
@@ -0,0 +1,99 @@
+/*
+ * Copyright © 2026 Innkeeper contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vk_ohos.h"
+
+#include "vk_common_entrypoints.h"
+#include "vk_device.h"
+#include "vk_native_buffer.h"
+#include "vk_queue.h"
+
+#include "drm-uapi/drm_fourcc.h"
+
+#include <string.h>
+
+/* BufferUsage bits from OpenHarmony's display_type.h. */
+#define OHOS_BUFFER_USAGE_MEM_DMA (1ull << 3)
+#define OHOS_BUFFER_USAGE_HW_RENDER (1ull << 8)
+#define OHOS_BUFFER_USAGE_HW_TEXTURE (1ull << 9)
+
+VkResult
+vk_ohos_get_native_buffer_layout(
+   const VkNativeBufferOHOS *native_buffer,
+   VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
+   VkSubresourceLayout *out_layout)
+{
+   const struct OHBufferHandle *handle = native_buffer->handle;
+
+   if (!handle || handle->fd < 0 || handle->stride <= 0)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   memset(out, 0, sizeof(*out));
+   memset(out_layout, 0, sizeof(*out_layout));
+
+   out->sType =
+      VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT;
+   out->drmFormatModifier = DRM_FORMAT_MOD_LINEAR;
+   out->drmFormatModifierPlaneCount = 1;
+   out->pPlaneLayouts = out_layout;
+   out_layout->rowPitch = handle->stride;
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_common_GetSwapchainGrallocUsageOHOS(VkDevice device, VkFormat format,
+                                       VkImageUsageFlags imageUsage,
+                                       uint64_t *grallocUsage)
+{
+   const VkImageUsageFlags render_usage =
+      VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+   const VkImageUsageFlags texture_usage =
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+      VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+   uint64_t usage = OHOS_BUFFER_USAGE_MEM_DMA;
+
+   if (imageUsage & ~(render_usage | texture_usage))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   if (!(imageUsage & (render_usage | texture_usage)))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   if (imageUsage & render_usage)
+      usage |= OHOS_BUFFER_USAGE_HW_RENDER;
+   if (imageUsage & texture_usage)
+      usage |= OHOS_BUFFER_USAGE_HW_TEXTURE;
+
+   /* The swapchain layer sets its own bits, such as CPU_READ for a linear
+    * swapchain, before it calls the driver.
+    */
+   *grallocUsage |= usage;
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_common_AcquireImageOHOS(VkDevice _device, VkImage image,
+                           int32_t nativeFenceFd, VkSemaphore semaphore,
+                           VkFence fence)
+{
+   VK_FROM_HANDLE(vk_device, device, _device);
+
+   return vk_native_buffer_acquire_image(device, nativeFenceFd, semaphore,
+                                         fence);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_common_QueueSignalReleaseImageOHOS(VkQueue _queue,
+                                      uint32_t waitSemaphoreCount,
+                                      const VkSemaphore *pWaitSemaphores,
+                                      VkImage image, int32_t *pNativeFenceFd)
+{
+   VK_FROM_HANDLE(vk_queue, queue, _queue);
+
+   return vk_native_buffer_signal_release_image(queue, waitSemaphoreCount,
+                                                pWaitSemaphores,
+                                                pNativeFenceFd);
+}
