# Graphics properties, staged as share/linuxapk/props.d/vulkan.prop and merged
# into /vendor/build.prop by linuxapk-session at start, which also sets
# ro.hardware.vulkan (radv, anv, or lvp). See android/vendor/vulkan/README.md.

# GLES/EGL implementation is selected by the launcher (ANGLE by default).
# GLES 3.2
ro.opengles.version=196610
