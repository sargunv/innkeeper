# Graphics properties, staged as share/innkeeper/props.d/vulkan.prop and merged
# into /vendor/build.prop by innkeeper-session at start, which also sets
# ro.hardware.vulkan (radv on an amdgpu render node, else lvp). See android/vendor/vulkan/README.md.

# GLES and EGL use ANGLE from /system/lib64 (libEGL_angle.so and others) on
# top of Vulkan.
ro.hardware.egl=angle
# GLES 3.2
ro.opengles.version=196610
