# Graphics properties for the Linux.apk vendor overlay (gpu lane), merged into
# /vendor/build.prop by host/launcher/linuxapk-session, which also sets
# ro.hardware.vulkan (radv on an amdgpu render node, else lvp). See docs/gpu.md.

# GLES/EGL: ANGLE from /system/lib64 (libEGL_angle.so etc.) on top of Vulkan.
ro.hardware.egl=angle
# GLES 3.2
ro.opengles.version=196610
