<!--
  Linux.apk probes: diagnostics for the tests and docs, never shipped. FileProbe has a launcher
  activity to exercise app mirroring in an isolated test desktop.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- NotificationProbe posts one, LocationProbe asks for locations (the tests install with
       -g). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

  <!-- ClipProbe has no window; its platform signature permits reading without focus. -->
  <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <application
    android:allowBackup="false"
    android:label="@string/app_name">

    <activity android:name=".ShareProbe" android:exported="true" android:label="Share probe">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
      </intent-filter>
    </activity>
    <activity-alias android:name=".MarkdownShareOnly" android:targetActivity=".ShareProbe" android:exported="true" android:label="Markdown only">
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/markdown" />
      </intent-filter>
    </activity-alias>

    <activity android:name=".FileProbe" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/markdown" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- Logs every input event it receives (tag LinuxApkProbe). -->
    <activity
      android:name=".InputProbeActivity"
      android:exported="true"
      android:label="@string/input_probe_name" />

    <!-- A focused text field that logs its text and keys (tag LinuxApkProbe). -->
    <activity
      android:name=".TextProbeActivity"
      android:exported="true"
      android:label="@string/text_probe_name" />

    <!-- Insets and elevation-shadow check for app windows (docs/display.md). -->
    <activity
      android:name=".WindowProbeActivity"
      android:exported="true"
      android:label="@string/window_probe_name" />

    <!-- Widgets for the accessibility test (tests/e2e/a11y). -->
    <activity
      android:name=".A11yProbeActivity"
      android:exported="true"
      android:label="@string/a11y_probe_name" />

    <!-- A notification with an action and an inline reply. -->
    <activity
      android:name=".NotificationProbe"
      android:excludeFromRecents="true"
      android:exported="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay" />
    <receiver
      android:name=".NotificationProbe$Receiver"
      android:exported="false" />

    <!-- Sets or logs the clipboard. -->
    <activity
      android:name=".ClipProbe"
      android:excludeFromRecents="true"
      android:exported="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay" />
    <provider
      android:name=".ClipImageProbe"
      android:authorities="dev.linuxapk.probes.clip"
      android:exported="false"
      android:grantUriPermissions="true" />

    <!-- Asks for locations and logs them (host location). -->
    <activity
      android:name=".LocationProbe"
      android:excludeFromRecents="true"
      android:exported="true" />
    <activity android:name=".DesktopProbe" android:exported="true" />
    <activity android:name=".HandoffProbe" android:exported="true" />
    <provider android:name=".HandoffProbe$FileProvider" android:authorities="dev.linuxapk.probes.handoff" android:exported="false" android:grantUriPermissions="true" />
    <activity android:name=".HandoffProbe$Claimed" android:exported="true" android:enabled="false" android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="mailto" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/vnd.oasis.opendocument.text" />
      </intent-filter>
    </activity>
    <activity android:name=".LifecycleProbe" android:exported="true" />
    <service android:name=".LifecycleProbe$Media" android:foregroundServiceType="mediaPlayback" android:exported="false" />
    <receiver android:name=".LifecycleProbe$Alarm" android:exported="false">
      <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
    </receiver>
  </application>
</manifest>
