<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!--
  Innkeeper probes are diagnostics for the tests and docs and are not shipped. FileProbe has a
  launcher activity to exercise app mirroring in an isolated test desktop.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- NotificationProbe posts a notification. The tests install with -g to grant this. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- This is an ordinary, non-game application. Android 17 suppresses density-driven
       restarts only for game-category apps (AppCompatDisplayCompatPolicy), and the
       teardown probes must restart so that the tests exercise the display-move relaunch. -->
  <application
    android:allowBackup="false"
    android:label="@string/app_name">

    <activity android:name=".AudioCaptureProbe" android:exported="true" />
    <activity android:name=".WindowProbe" android:exported="true" android:label="Window probe" android:configChanges="density|screenSize|smallestScreenSize|orientation|screenLayout" />
    <activity android:name=".WideColorProbe" android:exported="true" android:label="Wide colour probe" />
    <activity android:name=".WideColorProbe$Hdr" android:exported="true" android:label="HDR probe" />
    <activity android:name=".BenchProbe" android:exported="true" android:label="Benchmark probe" />

    <activity android:name=".TaskWindowProbe" android:exported="true" />

    <activity android:name=".ShareProbe" android:exported="true" android:label="Share probe">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
      </intent-filter>
    </activity>
    <activity-alias android:name=".MarkdownShareOnly" android:targetActivity=".ShareProbe" android:exported="true" android:label="Markdown only">
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/markdown" />
      </intent-filter>
    </activity-alias>

    <activity android:name=".FileProbe" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/markdown" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- Logs every input event it receives (tag InnkeeperProbe). -->
    <activity
      android:name=".InputProbeActivity"
      android:exported="true"
      android:label="@string/input_probe_name" />

    <activity android:name=".CaptureProbeActivity" android:exported="true" android:label="Capture probe" />


    <!-- Game-category probe for immersive mode and requested orientation. -->
    <activity
      android:name=".WindowModeProbe"
      android:exported="true"
      android:launchMode="singleTop"
      android:screenOrientation="portrait"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
    <activity
      android:name=".WindowModeProbe$ReturnActivity"
      android:exported="true"
      android:screenOrientation="portrait" />

    <!-- Insets and elevation-shadow check for app windows (docs/display.md). -->
    <activity
      android:name=".WindowProbeActivity"
      android:exported="true"
      android:label="@string/window_probe_name" />

    <!-- Closing and recreating fixture for the boot group's teardown check. It declares no
         configChanges, so it relaunches on every display move. -->
    <activity
      android:name=".TeardownProbe"
      android:exported="true"
      android:label="@string/teardown_probe_name" />

    <!-- A notification with an action and an inline reply. -->
    <activity
      android:name=".NotificationProbe"
      android:excludeFromRecents="true"
      android:exported="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay" />
    <receiver
      android:name=".NotificationProbe$Receiver"
      android:exported="false" />

    <activity
      android:name=".DesktopProbe"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:exported="true" />
    <receiver android:name=".StorageProbe" android:exported="true" />
    <!-- Reparenting the task must not recreate the file provider's caller and send
         a second VIEW while the first handoff is still reading its grant. -->
    <activity
      android:name=".HandoffProbe"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:exported="true" />
    <provider android:name=".HandoffProbe$FileProvider" android:authorities="dev.sargunv.innkeeper.probes.handoff" android:exported="false" android:grantUriPermissions="true" />
    <activity android:name=".LifecycleProbe" android:exported="true" />
    <service android:name=".LifecycleProbe$Media" android:foregroundServiceType="mediaPlayback" android:exported="false" />
    <receiver android:name=".LifecycleProbe$Alarm" android:exported="false">
      <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
    </receiver>
    <service android:name=".LifecycleProbe$Job" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
  </application>
</manifest>
