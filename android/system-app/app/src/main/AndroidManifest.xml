<!--
  Innkeeper System is a privileged, platform-signed, persistent app. It is
  installed in /system_ext/priv-app/InnkeeperSystem together with
  /system_ext/etc/permissions/dev.sargunv.innkeeper.system.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Per-app management through the session bridge. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
  <uses-permission android:name="android.permission.INTERNAL_DELETE_CACHE_FILES" />
  <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" />
  <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
  <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
  <uses-permission android:name="android.permission.REVOKE_RUNTIME_PERMISSIONS" />
  <uses-permission android:name="android.permission.GET_RUNTIME_PERMISSIONS" />

  <!-- Signature permissions, granted by the platform key. -->
  <uses-permission android:name="android.permission.INJECT_EVENTS" />
  <uses-permission android:name="android.permission.ASSOCIATE_INPUT_DEVICE_TO_DISPLAY" />
  <uses-permission android:name="android.permission.SET_POINTER_SPEED" />

  <!-- The window manager (docs/display.md) creates trusted, always-unlocked virtual displays
       with their own focus and display group. They are secure so that FLAG_SECURE windows
       aren't blacked out. -->
  <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />
  <uses-permission android:name="android.permission.ADD_ALWAYS_UNLOCKED_DISPLAY" />
  <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
  <!-- For launching onto any display, moving tasks between displays, and setting the display
       IME policy. -->
  <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
  <!-- For the task stack listener, focusTopTask, removing tasks, and seeing every app's tasks. -->
  <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
  <uses-permission android:name="android.permission.REMOVE_TASKS" />
  <uses-permission android:name="android.permission.REORDER_TASKS" />
  <uses-permission android:name="android.permission.MANAGE_APP_TOKENS" />
  <uses-permission android:name="android.permission.SET_ORIENTATION" />
  <!-- For the labels and launch intents of the apps it opens. -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <!-- Signature|privileged permissions, allowlisted in dev.sargunv.innkeeper.system.xml. -->
  <uses-permission android:name="android.permission.REAL_GET_TASKS" />
  <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
  <!-- A signature|privileged permission. It lets the app make the Innkeeper Keyboard the default
       input method, turn the accessibility service on and off, and apply the desktop settings
       below. -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

  <!-- Desktop integration (host/bridge/src/system/proto.rs). Holders get the "audio" group,
       which may enter the host bridge's socket directory (/dev/socket/innkeeper, root:audio 0750).
       The bridge admits only this app's uid to its system service. -->
  <permission
    android:name="dev.sargunv.innkeeper.permission.HOST_BRIDGE"
    android:protectionLevel="signature" />

  <uses-permission android:name="dev.sargunv.innkeeper.permission.HOST_BRIDGE" />
  <!-- For the desktop settings: night mode, theme seed, contrast and animation scales, time
       zone, locales, 12/24-hour clock and font scale. -->
  <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />
  <uses-permission android:name="android.permission.SET_TIME_ZONE" />
  <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
  <!-- For forwarding notifications to the desktop: granting the app's own listener access, and
       controlling media sessions. -->
  <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
  <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
  <!-- Audio playback callbacks with the playing app's uid (PlaybackApps). Without it the
       callback's configurations are anonymized and the desktop mixer cannot name the app. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
  <!-- For clipboard sync while none of the app's windows has focus. -->
  <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
  <!-- For the default browser role (BrowserRole), which sends ordinary links to the desktop. -->
  <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
  <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
  <!-- For host state (integration/HostStateFeature.kt): the network location provider, its gps
       test provider, which needs the app to grant itself the mock location app op, and the
       battery saver. -->
  <uses-permission android:name="android.permission.INSTALL_LOCATION_PROVIDER" />
  <uses-permission android:name="android.permission.LOCATION_HARDWARE" />
  <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
  <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
  <uses-permission android:name="android.permission.DEVICE_POWER" />
  <!-- For registering the host's network as Android's (integration/network/HostNetworkFeature.kt). -->
  <uses-permission android:name="android.permission.NETWORK_FACTORY" />

  <application
    android:name=".InnkeeperSystemApp"
    android:allowBackup="false"
    android:directBootAware="true"
    android:label="@string/app_name"
    android:persistent="true">

    <!-- Display 0 has no desktop window. HOME stays in this app's existing persistent process.
         Apps use their own virtual displays, and the desktop handles task switching. -->
    <activity
      android:name=".wm.HomeActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Shows the deprecated-target-SDK warning in the app's window (see AppWarningActivity). -->
    <activity
      android:name=".wm.AppWarningActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- The Innkeeper Keyboard connects the host keyboard and input methods through
         zwp_text_input_v3 (docs/input.md). -->
    <service
      android:name=".ime.HostImeService"
      android:exported="true"
      android:label="@string/ime_name"
      android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/method" />
    </service>

    <!-- Exposes Android apps on the desktop's AT-SPI bus (a11y/ and host/bridge/src/a11y/).
         A11yFeature enables it while the desktop's assistive technologies are on. -->
    <service
      android:name=".a11y.HostAccessibilityService"
      android:exported="true"
      android:label="@string/a11y_name"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service" />
    </service>

    <!-- The document picker opens the desktop's file chooser (documents/ and
         host/bridge/src/documents/proto.rs). Its priority of 200 outranks DocumentsUI's 100. -->
    <activity
      android:name=".documents.PickerActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:excludeFromRecents="true"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.OPEN_DOCUMENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.CREATE_DOCUMENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.GET_CONTENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- The CLI's app chooser, opened through the same fd-grant VIEW path that apps use. -->
    <activity
      android:name=".documents.OpenWithActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:label="@string/open_with_title"
      android:theme="@android:style/Theme.Material.Light.Dialog.Alert" />

    <!-- Serves picked host files as documents. They are reachable only through granted URIs. -->
    <provider
      android:name=".documents.HostDocumentsProvider"
      android:authorities="dev.sargunv.innkeeper.system.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>

    <!-- Forwards Android notifications to the desktop (integration/). -->
    <service
      android:name=".integration.notifications.NotificationForwarder"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- The default browser role routes ordinary http(s) links here, and this activity opens
         them on the desktop. Verified App Links take precedence over the browser role. -->
    <activity
      android:name=".integration.browser.BrowserActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/browser_name"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="http" />
        <data android:scheme="https" />
      </intent-filter>
    </activity>

    <!-- Android 17 matches schemes literally, so the filter lists each external scheme. The */*
         MIME filter catches unclaimed content and file VIEWs. Priority -1000 lets real Android
         handlers go first. -->
    <!-- Handoffs may move with the caller's task onto its virtual display. The activity handles
         the configuration change in place because Android 17's display-compat self-kill
         recovery can otherwise relaunch it onto a display that the window manager has already
         released (#98). -->
    <activity
      android:name=".integration.handoff.HandoffActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="Desktop"
      android:theme="@android:style/Theme.Material.Light.Dialog.Alert">
      <intent-filter android:priority="-1000">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="mailto" />
        <data android:scheme="tel" />
        <data android:scheme="sms" />
        <data android:scheme="smsto" />
        <data android:scheme="geo" />
        <data android:scheme="market" />
        <data android:scheme="magnet" />
        <data android:scheme="webcal" />
        <data android:scheme="webcals" />
        <data android:scheme="ftp" />
        <data android:scheme="ftps" />
      </intent-filter>
      <intent-filter android:priority="-1000">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>

    <!-- Custom Tabs provider stub, so Custom Tabs and AppAuth see a browser. -->
    <service
      android:name=".integration.browser.CustomTabsService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.action.CustomTabsService" />
      </intent-filter>
    </service>

    <!-- Provides the desktop's location as Android's network provider (integration/location/).
         At version 0, any other provider outranks it. -->
    <service
      android:name=".integration.location.HostLocationService"
      android:directBootAware="true"
      android:exported="true"
      android:permission="android.permission.INSTALL_LOCATION_PROVIDER">
      <intent-filter>
        <action android:name="com.android.location.service.v3.NetworkLocationProvider" />
      </intent-filter>
      <meta-data
        android:name="serviceVersion"
        android:value="0" />
    </service>

    <!-- Serve files and images copied on the desktop to Android apps that paste them. -->
    <provider
      android:name=".integration.clipboard.ClipFileProvider"
      android:authorities="dev.sargunv.innkeeper.system.clipboard.files"
      android:exported="false"
      android:grantUriPermissions="true" />
    <provider
      android:name=".integration.clipboard.ClipImageProvider"
      android:authorities="dev.sargunv.innkeeper.system.clipboard"
      android:exported="false"
      android:grantUriPermissions="true" />
  </application>
</manifest>
