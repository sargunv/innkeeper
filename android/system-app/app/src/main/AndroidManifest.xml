<!--
  Linux.apk System: privileged, platform-signed, persistent. Installed in
  /system_ext/priv-app/LinuxApkSystem with
  /system_ext/etc/permissions/dev.linuxapk.system.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- signature: granted by the platform key. -->
  <uses-permission android:name="android.permission.INJECT_EVENTS" />

  <!-- Window manager (docs/display.md). Trusted, always-unlocked virtual displays with their
       own focus and display group; secure, so FLAG_SECURE windows aren't blacked out. -->
  <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />
  <uses-permission android:name="android.permission.ADD_ALWAYS_UNLOCKED_DISPLAY" />
  <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
  <!-- Launching onto any display, moving tasks between displays, display IME policy. -->
  <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
  <!-- Task stack listener, focusTopTask; removing tasks; every app's tasks. -->
  <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
  <uses-permission android:name="android.permission.REMOVE_TASKS" />
  <uses-permission android:name="android.permission.REORDER_TASKS" />
  <uses-permission android:name="android.permission.MANAGE_APP_TOKENS" />
  <uses-permission android:name="android.permission.SET_ORIENTATION" />
  <!-- Labels and launch intents of the apps it opens. -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <!-- signature|privileged: listed in dev.linuxapk.system.xml. -->
  <uses-permission android:name="android.permission.REAL_GET_TASKS" />
  <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
  <!-- signature|privileged: makes the Linux.apk Keyboard the default input method, turns the
       accessibility service on and off, and applies the desktop settings below. -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

  <!-- Desktop integration (host/bridge/src/system/proto.rs). Holders get the "audio" group,
       which may enter the host bridge's socket directory (/dev/socket/linuxapk, root:audio 0750);
       the bridge then admits only this app's uid to its system service. -->
  <permission
    android:name="dev.linuxapk.permission.HOST_BRIDGE"
    android:protectionLevel="signature" />

  <uses-permission android:name="dev.linuxapk.permission.HOST_BRIDGE" />
  <!-- Desktop settings: night mode, theme seed, contrast and animation scales, time zone,
       locales, 12/24-hour clock, font scale. -->
  <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />
  <uses-permission android:name="android.permission.SET_TIME_ZONE" />
  <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
  <!-- Notifications to the desktop: our own listener access; media sessions. -->
  <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
  <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
  <!-- Clipboard sync while no window of ours has focus. -->
  <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
  <!-- Default browser role (BrowserRole), when no real browser has it. -->
  <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
  <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
  <!-- Host state (integration/HostStateFeature.kt): the network location provider and its gps
       test provider (granting itself the mock location app op), and the battery saver. -->
  <uses-permission android:name="android.permission.INSTALL_LOCATION_PROVIDER" />
  <uses-permission android:name="android.permission.LOCATION_HARDWARE" />
  <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
  <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
  <uses-permission android:name="android.permission.DEVICE_POWER" />
  <!-- Flatpak mode: the host's network as Android's (net/HostNetworkFeature.kt). -->
  <uses-permission android:name="android.permission.NETWORK_FACTORY" />

  <!-- Who may drive the window manager's ControlReceiver; root (the host side, through
       "linuxapk-session exec") passes any permission check. -->
  <permission
    android:name="dev.linuxapk.permission.CONTROL_WINDOWS"
    android:protectionLevel="signature" />

  <application
    android:name=".LinuxApkSystemApp"
    android:allowBackup="false"
    android:directBootAware="true"
    android:label="@string/app_name"
    android:persistent="true">

    <!-- Display 0 has no desktop window. HOME stays in our existing persistent process;
         apps use their own virtual displays, and the desktop owns task switching. -->
    <activity
      android:name=".wm.HomeActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- The deprecated-target-SDK warning, in the app's window (see AppWarningActivity). -->
    <activity
      android:name=".wm.AppWarningActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Linux.apk Keyboard: host keyboard and input methods through zwp_text_input_v3
         (docs/input.md). -->
    <service
      android:name=".ime.HostImeService"
      android:exported="true"
      android:label="@string/ime_name"
      android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/method" />
    </service>

    <!-- Android apps on the desktop's AT-SPI bus (a11y/; host/bridge/src/a11y/). Enabled by
         A11yFeature only while the desktop's assistive technologies are on. -->
    <service
      android:name=".a11y.HostAccessibilityService"
      android:exported="true"
      android:label="@string/a11y_name"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service" />
    </service>

    <!-- Document picker: the desktop's file chooser (documents/;
         host/bridge/src/documents/proto.rs). Outranks DocumentsUI (priority 100). -->
    <activity
      android:name=".documents.PickerActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:excludeFromRecents="true"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.OPEN_DOCUMENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.CREATE_DOCUMENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.GET_CONTENT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter android:priority="200">
        <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- The CLI's file chooser, opened through the same fd-grant VIEW path as an app. -->
    <activity
      android:name=".documents.OpenWithActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:label="@string/open_with_title"
      android:theme="@android:style/Theme.Material.Light.Dialog.Alert" />

    <!-- The picked host files as documents; reachable only through granted URIs. -->
    <provider
      android:name=".documents.HostDocumentsProvider"
      android:authorities="dev.linuxapk.system.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>

    <receiver
      android:name=".wm.ControlReceiver"
      android:exported="true"
      android:permission="dev.linuxapk.permission.CONTROL_WINDOWS">
      <intent-filter>
        <action android:name="dev.linuxapk.LAUNCH" />
        <action android:name="dev.linuxapk.LIST" />
        <action android:name="dev.linuxapk.CLOSE" />
        <action android:name="dev.linuxapk.BACKGROUND" />
      </intent-filter>
    </receiver>

    <!-- Desktop integration (integration/). Android notifications to the desktop. -->
    <service
      android:name=".integration.notifications.NotificationForwarder"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Fallback browser: http(s) links nothing else handles open in the host browser. The low
         priority (honoured for privileged apps) lets real browsers and app links win. -->
    <activity
      android:name=".integration.browser.BrowserActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/browser_name"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay">
      <intent-filter android:priority="-100">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="http" />
        <data android:scheme="https" />
      </intent-filter>
    </activity>

    <!-- Android 17 matches schemes literally, so enumerate external schemes. MIME */*
         catches unclaimed content/file VIEWs. Priority -1000 leaves real Android handlers first. -->
    <!-- Handoffs may move with the caller's task onto its virtual display. Handle the
         configuration change in place: Android 17's display-compat self-kill recovery can
         otherwise relaunch onto a display our window manager has already released (#98). -->
    <activity
      android:name=".integration.handoff.HandoffActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="Desktop"
      android:theme="@android:style/Theme.Material.Light.Dialog.Alert">
      <intent-filter android:priority="-1000">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="mailto" />
        <data android:scheme="tel" />
        <data android:scheme="sms" />
        <data android:scheme="smsto" />
        <data android:scheme="geo" />
        <data android:scheme="market" />
        <data android:scheme="magnet" />
        <data android:scheme="webcal" />
        <data android:scheme="webcals" />
        <data android:scheme="ftp" />
        <data android:scheme="ftps" />
      </intent-filter>
      <intent-filter android:priority="-1000">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>

    <!-- Custom Tabs provider stub, so Custom Tabs and AppAuth see a browser. -->
    <service
      android:name=".integration.browser.CustomTabsService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.action.CustomTabsService" />
      </intent-filter>
    </service>

    <!-- The desktop's location as Android's network provider (integration/location/). Version 0:
         microG's provider, when installed, outranks it. -->
    <service
      android:name=".integration.location.HostLocationService"
      android:directBootAware="true"
      android:exported="true"
      android:permission="android.permission.INSTALL_LOCATION_PROVIDER">
      <intent-filter>
        <action android:name="com.android.location.service.v3.NetworkLocationProvider" />
      </intent-filter>
      <meta-data
        android:name="serviceVersion"
        android:value="0" />
    </service>

    <!-- Images copied on the desktop, pasted into Android apps. -->
    <provider
      android:name=".integration.clipboard.ClipFileProvider"
      android:authorities="dev.linuxapk.system.clipboard.files"
      android:exported="false"
      android:grantUriPermissions="true" />
    <provider
      android:name=".integration.clipboard.ClipImageProvider"
      android:authorities="dev.linuxapk.system.clipboard"
      android:exported="false"
      android:grantUriPermissions="true" />
  </application>
</manifest>
