<!-- Installed as /system_ext/etc/sysconfig/microg.xml by android/microg/install.sh.
     GmsCore keeps the push (MCS) connection: exempt it from Doze and from
     Data Saver, as AOSP's GMS sysconfig does for Google's GmsCore. -->
<config>
  <allow-in-power-save package="com.google.android.gms" />
  <allow-in-data-usage-save package="com.google.android.gms" />
</config>
