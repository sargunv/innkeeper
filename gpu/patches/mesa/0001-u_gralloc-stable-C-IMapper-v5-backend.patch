+#undef hw_get_module
+int
+u_gralloc_hw_get_module(const char *id, const struct hw_module_t **module)
+{
+   static int (*fn)(const char *, const struct hw_module_t **);
+   static bool tried;
+
+   /* Racy but idempotent: callers are serialized by u_gralloc_mutex. */
+   if (!tried) {
+      void *lib = dlopen("libhardware.so", RTLD_NOW | RTLD_LOCAL);
+      if (lib)
+         fn = (int (*)(const char *, const struct hw_module_t **))dlsym(lib, "hw_get_module");
+      tried = true;
+   }
+
+   if (!fn)
+      return -ENOENT;
+
+   return fn(id, module);
+}
