# Graphics driver selection for the Linux.apk vendor overlay (gpu lane).
# The session lane loads these as vendor properties. See docs/gpu.md.

# Vulkan HAL: libvulkan loads /vendor/lib64/hw/vulkan.<value>.so.
#   radv = Mesa RADV (AMD GCN/RDNA via /dev/dri/renderD*)
#   lvp  = Mesa lavapipe (CPU, any machine)
# The session should pick radv only when the render node's kernel driver is
# amdgpu, else lvp.
ro.hardware.vulkan=radv

# GLES/EGL: ANGLE from /system/lib64 (libEGL_angle.so etc.) on top of Vulkan.
ro.hardware.egl=angle
# GLES 3.2
ro.opengles.version=196610

# Mesa's u_gralloc finds the IMapper v5 suffix through IAllocator itself;
# set this only to override it (e.g. in tests): mesa.gralloc.mapper.suffix=<suffix>
