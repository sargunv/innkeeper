# Build tools for cross-compiling Mesa, libdrm and LLVM for Android with the NDK.
# The NDK itself is used from the host ($HOME is bind-mounted), pinned in build.sh.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install \
      meson ninja-build cmake pkgconf-pkg-config git patch patchelf file \
      python3 python3-mako python3-pyyaml python3-packaging \
      glslang bison flex gcc gcc-c++ xz \
    && dnf clean all
