# AOSP build environment (Google's supported host is Ubuntu LTS).
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      git git-lfs curl ca-certificates python3 python-is-python3 zip unzip rsync \
      build-essential flex bison gperf libssl-dev libncurses-dev libxml2-utils \
      fontconfig zlib1g-dev x11proto-core-dev libx11-dev libgl1-mesa-dev \
      xsltproc lib32z1-dev ccache file procps meson ninja-build pkg-config \
      python3-mako python3-yaml glslang-tools \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sfL https://storage.googleapis.com/git-repo-downloads/repo -o /usr/local/bin/repo && chmod +x /usr/local/bin/repo
